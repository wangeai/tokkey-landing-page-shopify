{% comment %}
  Minimal document shell for the Tokkey landing pages.
  Skips the theme header, footer, drawers and base styles, which these pages don't use;
  all page styling comes from assets/tokkey.css.
{% endcomment %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {%- if settings.favicon != blank -%}
      <link
        rel="icon"
        type="image/png"
        href="{{ settings.favicon | image_url: width: 32, height: 32 }}"
      >
    {%- else -%}
      {%- comment -%} Default to the Tokkey logo mark when no favicon is set in theme settings {%- endcomment -%}
      <link rel="icon" type="image/svg+xml" href="{{ 'mark.svg' | asset_url }}">
    {%- endif -%}

    {%- render 'meta-tags' -%}
    {{ 'tokkey.css' | asset_url | stylesheet_tag }}

    {{ content_for_header }}
  </head>

  <body>
    {{ content_for_layout }}
  </body>
</html>
