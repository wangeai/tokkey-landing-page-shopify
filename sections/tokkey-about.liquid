{% comment %}
  Section contract.
  Tokkey About page (Tokkey Editions, Winter '26), ported from the tokkey-landing-page repo (src/pages/about.astro):
  an intro, three chapters (Prometheus, Archimedes, Arthur), a marquee, the closing CTA and the shared Tokkey footer.
  Styles: snippets/tokkey-about-styles.liquid. Behaviour: <tokkey-about> in assets/tokkey-about.js.
  @example
  <!-- templates/page.about.json renders this section with "layout": "tokkey"; assign the "about" template to the
       /pages/about page in Shopify Admin -->
{% endcomment %}

{% render 'tokkey-mono-font' %}
{% render 'tokkey-about-styles' %}
{%- comment -%} Inter italic for the emphasised words (assets/tokkey.css loads upright Inter only) {%- endcomment -%}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@1,400;1,600&display=swap">

<div class="tokkey-about-page">
  {%- comment -%} Nav sits outside .about so the page's bare `a` rules don't restyle it {%- endcomment -%}
  {% render 'tokkey-topnav' %}

  <tokkey-about class="about">
    <!-- Intro overlay: brackets and the edition title while the scene is dark -->
    <div class="intro-ui" data-ref="intro" aria-hidden="true">
      <i class="brk tl"></i><i class="brk tr"></i><i class="brk bl"></i><i class="brk br"></i>
      <div class="title"><span>The</span><em>Prometheus</em><span>Edition</span></div>
      <div class="skip">Click to skip</div>
    </div>

    <!-- Shared filters for the torn paper edges (snippets/tokkey-about-tear.liquid) -->
    <svg width="0" height="0" aria-hidden="true" style="position:absolute">
      <defs>
        <filter id="tfib" x="-5%" y="-80%" width="110%" height="260%">
          <feTurbulence type="fractalNoise" baseFrequency="0.32 0.025" numOctaves="3" seed="7" result="n"></feTurbulence>
          <feDisplacementMap in="SourceGraphic" in2="n" scale="16" xChannelSelector="R" yChannelSelector="G"></feDisplacementMap>
          <feGaussianBlur stdDeviation="0.7"></feGaussianBlur>
        </filter>
        <filter id="trag" x="-5%" y="-80%" width="110%" height="260%">
          <feTurbulence type="fractalNoise" baseFrequency="0.9 0.35" numOctaves="2" seed="3" result="n"></feTurbulence>
          <feDisplacementMap in="SourceGraphic" in2="n" scale="7" xChannelSelector="R" yChannelSelector="G"></feDisplacementMap>
        </filter>
        <filter id="tsoft" x="-5%" y="-80%" width="110%" height="260%">
          <feGaussianBlur stdDeviation="9"></feGaussianBlur>
        </filter>
      </defs>
    </svg>

    <nav class="index" data-ref="index" aria-label="Chapters">
      <a href="#ch1"><span>Prometheus</span><i>I</i></a>
      <a href="#ch2"><span>Archimedes</span><i>II</i></a>
      <a href="#ch3"><span>Arthur</span><i>III</i></a>
      <a href="#cta"><span>Waitlist</span><i>IV</i></a>
    </nav>

    {% render 'tokkey-about-prometheus' %}
    {% render 'tokkey-about-archimedes' %}
    {% render 'tokkey-about-arthur' %}

    {%- comment -%} Marquee phrases, repeated twice so the -50% loop is seamless {%- endcomment -%}
    {%- assign marquee = 'Local first|Private by default|Plug in, light up|No cloud required' | split: '|' -%}
    <div class="marquee" aria-hidden="true">
      <div>
        {%- for i in (1..2) -%}
          {%- for phrase in marquee -%}
            {{ phrase }} <em>✦</em>{{ ' ' }}
          {%- endfor -%}
        {%- endfor -%}
      </div>
    </div>

    <section id="cta">
      <canvas id="embers" aria-hidden="true"></canvas>
      <h2>Take the <em>fire</em><span class="p">.</span></h2>
      <p>Tokkey Editions. Winter '26.</p>
      <a class="cta-btn" href="#fs-early-access"><span class="led"></span>Reserve your spot</a>
    </section>
  </tokkey-about>

  {% render 'tokkey-footer' %}
</div>

<script src="{{ 'tokkey-about.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "t:names.tokkey_about",
  "tag": "section",
  "class": "tokkey-about-section"
}
{% endschema %}
