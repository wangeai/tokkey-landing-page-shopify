{% comment %}
  Section contract.
  Tokkey FAQ page, ported from the homepage FAQ in the tokkey-landing-page repo (src/components/Faq.astro,
  copy from src/config/faq.ts): the floating nav, a "FAQ." heading over hairline-separated native <details>
  rows (the first starts open), FAQPage structured data built from the same rows, and the shared footer.
  Each question is a block, so merchants edit, add and reorder them in the theme editor.
  @example
  <!-- templates/page.faq.json renders this section with "layout": "tokkey"; assign the "faq" template to
       the /pages/faq page in Shopify Admin -->
{% endcomment %}

<div class="tokkey-faq">
  <main class="tk-faq">
    {% render 'tokkey-topnav' %}
    <h1 class="tk-faq__heading">{{ section.settings.heading | escape }}<span class="tk-faq__dot" aria-hidden="true">.</span></h1>
    <div class="tk-faq__list">
      {%- for block in section.blocks -%}
        {%- if block.settings.question != blank -%}
          <details class="tk-faq__item" {% if forloop.first %}open{% endif %} {{ block.shopify_attributes }}>
            <summary class="tk-faq__question">
              {{ block.settings.question | escape }}
              <span class="tk-faq__icon" aria-hidden="true">+</span>
            </summary>
            <div class="tk-faq__answer">{{ block.settings.answer }}</div>
          </details>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </main>
  {% render 'tokkey-footer' %}
</div>

{%- comment -%} FAQ rich result built from the same rows the page renders {%- endcomment -%}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {%- for block in section.blocks -%}
        {%- if block.settings.question != blank -%}
          {%- unless forloop.first %},{% endunless -%}
          {
            "@type": "Question",
            "name": {{ block.settings.question | json }},
            "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} }
          }
        {%- endif -%}
      {%- endfor -%}
    ]
  }
</script>

{% stylesheet %}
  /* FAQ page (homepage FAQ from the tokkey-landing-page repo). Desktop sizes are Figma px via --fx. */
  .tokkey-faq {
    --fx: 1px;
    --tk-faq-hair: #2e2e2b;
    --tk-faq-accent: #4abe18;
    background: #000;
    color: #fff;
    font-family: Inter, -apple-system, BlinkMacSystemFont, Helvetica Neue, Arial, sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  /* Relative so the absolutely positioned top nav sits over the top of the page */
  .tk-faq {
    position: relative;
    padding: 120px 16px 80px;
  }

  .tk-faq__heading {
    margin: 0 0 32px;
    font-size: 40px;
    font-weight: 500;
    line-height: 44px;
    letter-spacing: -0.03em;
  }

  .tk-faq__dot {
    color: var(--tk-faq-accent);
  }

  .tk-faq__list {
    border-top: 1px solid var(--tk-faq-hair);
  }

  .tk-faq__item {
    border-bottom: 1px solid var(--tk-faq-hair);
    interpolate-size: allow-keywords;
  }

  /* Slide the answer open / closed (progressive: browsers without ::details-content just toggle) */
  .tk-faq__item::details-content {
    height: 0;
    overflow: clip;
    transition: height 0.35s ease, content-visibility 0.35s allow-discrete;
  }

  .tk-faq__item[open]::details-content {
    height: auto;
  }

  .tk-faq__question {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    padding: 24px 0;
    font-size: 20px;
    line-height: 28px;
    letter-spacing: -0.01em;
    list-style: none;
    cursor: pointer;
  }

  .tk-faq__question::-webkit-details-marker {
    display: none;
  }

  .tk-faq__question:focus-visible {
    outline: 2px solid var(--tk-faq-accent);
    outline-offset: 4px;
  }

  .tk-faq__icon {
    flex: none;
    color: #8a8a90;
    transition: transform 0.25s ease, color 0.25s ease;
  }

  .tk-faq__item[open] .tk-faq__icon {
    transform: rotate(45deg);
    color: var(--tk-faq-accent);
  }

  .tk-faq__answer {
    padding: 0 32px 24px 0;
    font-size: 16px;
    line-height: 24px;
    color: rgb(255 255 255 / 0.6);
  }

  .tk-faq__answer p {
    margin: 0;
  }

  .tk-faq__answer p + p {
    margin-top: 12px;
  }

  .tk-faq__answer a {
    color: #fff;
  }

  @media (prefers-reduced-motion: reduce) {
    .tk-faq__item::details-content,
    .tk-faq__icon {
      transition: none;
    }
  }

  @media (min-width: 768px) {
    .tokkey-faq {
      --fx: max(100vw / 1920, 0.6px);
    }

    .tk-faq {
      padding: max(160px, calc(200 * var(--fx))) calc(146 * var(--fx)) calc(80 * var(--fx));
    }

    .tk-faq__heading {
      margin-bottom: calc(40 * var(--fx));
      font-size: calc(80 * var(--fx));
      line-height: calc(88 * var(--fx));
    }

    /* Floors keep text at least as large as on phones when --fx shrinks below 1px */
    .tk-faq__question {
      font-size: max(20px, calc(24 * var(--fx)));
      line-height: 1.3;
    }

    .tk-faq__answer {
      font-size: max(16px, calc(16 * var(--fx)));
      line-height: 1.5;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.tokkey_faq",
  "tag": "section",
  "class": "tokkey-faq-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "FAQ"
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "t:names.accordion_row",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "t:settings.title"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "t:settings.content"
        }
      ]
    }
  ]
}
{% endschema %}
