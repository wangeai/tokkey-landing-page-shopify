{% stylesheet %}
  /* The homepage spans the full viewport; lift the 1920px cap tokkey.css sets for other pages */
  .tokkey-landing .lp,
  .tokkey-landing .tkfoot {
    max-width: none;
  }

  /* Floating glass nav bar over the hero (Figma node 1639:11205: 1888px wide on a 1920 frame) */
  .tk-topnav {
    position: absolute;
    z-index: 3;
    inset-block-start: 16px;
    inset-inline: 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 16px 36px;
    border-radius: 10px;
    background: var(--tk-topnav-bg) center / 100% 100% no-repeat;
    line-height: normal;
    font-family: Geist, Inter, -apple-system, Helvetica Neue, Arial, sans-serif;
  }

  .tk-topnav__logo {
    display: flex;
    flex: none;
  }

  .tk-topnav .tk-topnav__logo img {
    display: block;
    width: 171px;
    height: 32px;
  }

  .tk-topnav__menu {
    display: flex;
    align-items: center;
    gap: 37px;
    min-width: 0;
  }

  .tk-topnav__link {
    color: rgb(255 255 255 / 0.72);
    font-size: 16px;
    font-weight: 400;
    text-decoration: none;
    white-space: nowrap;
  }

  .tk-topnav__link:hover {
    color: #fff;
  }

  .tk-topnav__cta {
    padding: 0 22px;
    border-radius: 23px;
    background: #fff;
    color: #000;
    font-size: 16px;
    font-weight: 600;
    line-height: 44px;
    text-decoration: none;
    white-space: nowrap;
  }

  .tk-topnav a:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 3px;
    border-radius: 4px;
  }

  .tk-topnav .tk-topnav__cta:focus-visible {
    border-radius: 23px;
  }

  @media (max-width: 768px) {
    .tk-topnav {
      inset-block-start: 10px;
      inset-inline: 10px;
      padding: 10px 14px;
    }

    .tk-topnav .tk-topnav__logo img {
      width: 107px;
      height: 20px;
    }

    .tk-topnav__link {
      display: none;
    }

    .tk-topnav__cta {
      padding: 0 16px;
      font-size: 14px;
      line-height: 36px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.tokkey_landing",
  "tag": "section",
  "class": "tokkey-landing-section"
}
{% endschema %}
