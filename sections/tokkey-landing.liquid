      <div class="tx tx-m">
        <span style="left:7.407%;top:9.886%;width:85.185%;font-size:5.3704cqw;line-height:1.379;text-align:center">Pay $5 Deposit,<br>Lock the VIP Exclusive $129</span>
        <span style="left:10.861%;top:65.331%;width:40.963%;font-size:2.8779cqw;line-height:1.210;text-align:center">VIP ONLY</span>
        <span style="left:10.861%;top:69.011%;width:18.704%;font-size:7.6743cqw;line-height:1.210;text-align:center">$129</span>
