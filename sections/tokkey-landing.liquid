    {% render 'tokkey-storyboard-hero' %}
    {% render 'tokkey-bigger-models' %}
    {% render 'tokkey-cost-compare' %}
    {% render 'tokkey-features' %}
    {% render 'tokkey-film' %}
    {% render 'tokkey-coordinated-ai' %}
    {% render 'tokkey-early-access' %}
    {% render 'tokkey-everyday-tasks' %}
  </main>
  {% render 'tokkey-footer' %}
</div>

{% stylesheet %}
  /* The homepage spans the full viewport; lift the 1920px cap tokkey.css sets for other pages */
  .tokkey-landing .lp {
    max-width: none;
  }

  /* Mobile "Deposit Now" pill under the hero title; same green as the button drawn in the desktop image */
  .tk-hero-cta {
    display: none;
  }

  @media (max-width: 768px) {
    .tk-hero-cta {
      position: absolute;
      z-index: 2;
      inset-block-start: 35.5%;
      inset-inline-start: 50%;
      display: flex;
      align-items: center;
      gap: 2cqw;
      padding: 0 4.8cqw;
      border-radius: 999px;
      background: linear-gradient(180deg, #82ea57, #49bd18);
      color: #fff;
      font: 600 3.4cqw/8.8cqw Inter, -apple-system, Helvetica Neue, Arial, sans-serif;
      text-decoration: none;
      white-space: nowrap;
      transform: translateX(-50%);
    }

    .tk-hero-cta:focus-visible {
      outline: 2px solid #fff;
      outline-offset: 3px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.tokkey_landing",
  "tag": "section",
  "class": "tokkey-landing-section"
}
{% endschema %}
