{% doc %}
  Renders the floating glass nav bar shared by the Tokkey pages: wordmark, page links and the
  "Reserve your spot" CTA, which links to the deposit reservation product page. Fixed to the viewport so it
  stays visible while scrolling; render it outside any ancestor with transform, filter or container-type,
  which would trap the fixed positioning.

  @example
  {% render 'tokkey-topnav' %}
{% enddoc %}
<header class="tk-topnav" style="--tk-topnav-bg: url({{ 'tk-nav-bg.png' | asset_url }})">
  <a class="tk-topnav__logo" href="{{ routes.root_url }}">
    <img src="{{ 'tokkey-logo-green.svg' | asset_url }}" width="171" height="32" alt="Tokkey">
  </a>
  <nav class="tk-topnav__menu" aria-label="Main">
    <a class="tk-topnav__link" href="/pages/software">Software</a>
    <a class="tk-topnav__link" href="/pages/about">About</a>
    <a class="tk-topnav__cta" href="/products/tokkey-deposit-reservation">Reserve your spot</a>
  </nav>
</header>

{% stylesheet %}
  /* Full-width glass nav bar pinned to the top edge of the viewport */
  .tk-topnav {
    position: fixed;
    z-index: 50;
    inset-block-start: 0;
    inset-inline: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 16px 36px;
    background: var(--tk-topnav-bg) center / 100% 100% no-repeat;
    line-height: normal;
    font-family: Geist, Inter, -apple-system, Helvetica Neue, Arial, sans-serif;
  }

  .tk-topnav__logo {
    display: flex;
    flex: none;
  }

  .tk-topnav .tk-topnav__logo img {
    display: block;
    width: 171px;
    height: 32px;
  }

  .tk-topnav__menu {
    display: flex;
    align-items: center;
    gap: 37px;
    min-width: 0;
  }

  .tk-topnav__link {
    color: rgb(255 255 255 / 0.72);
    font-size: 16px;
    font-weight: 400;
    text-decoration: none;
    white-space: nowrap;
  }

  .tk-topnav__link:hover {
    color: #fff;
  }

  .tk-topnav__cta {
    padding: 0 22px;
    border-radius: 23px;
    background: #fff;
    color: #000;
    font-size: 16px;
    font-weight: 600;
    line-height: 44px;
    text-decoration: none;
    white-space: nowrap;
  }

  .tk-topnav a:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 3px;
    border-radius: 4px;
  }

  .tk-topnav .tk-topnav__cta:focus-visible {
    border-radius: 23px;
  }

  @media (max-width: 768px) {
    .tk-topnav {
      padding: 10px 14px;
    }

    .tk-topnav .tk-topnav__logo img {
      width: 107px;
      height: 20px;
    }

    .tk-topnav__menu {
      gap: 16px;
    }

    .tk-topnav__link {
      font-size: 14px;
    }

    .tk-topnav__cta {
      padding: 0 16px;
      font-size: 14px;
      line-height: 36px;
    }
  }

  /* Phones: shrink everything so logo, both links and the CTA still fit on one row */
  @media (max-width: 420px) {
    .tk-topnav {
      gap: 10px;
      padding: 8px 10px;
    }

    .tk-topnav .tk-topnav__logo img {
      width: 75px;
      height: 14px;
    }

    .tk-topnav__menu {
      gap: 10px;
    }

    .tk-topnav__link {
      font-size: 12px;
    }

    .tk-topnav__cta {
      padding: 0 10px;
      font-size: 12px;
      line-height: 30px;
    }
  }
{% endstylesheet %}
