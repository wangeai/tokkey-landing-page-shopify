      line-height: 26px;
    }

    .c6-st {
      position: static;
      width: auto;
      height: auto;
      overflow: visible;
      margin-top: 40px;
      border-top: 1px solid #2e2e2b;
      padding-top: 32px;
      display: grid;
      grid-template-columns: 1fr 1fr;
      column-gap: 24px;
      grid-template-areas: "m m" "a b" "c d" "e f";
    }

    /* Board art scaled to the desktop 1000×530 visible area; overlays use % of that box */
    .c6-art {
      grid-area: m;
      position: relative;
      inset: auto;
      aspect-ratio: 1000 / 530;
      margin-bottom: 32px;
    }

    .c6-bd,
    .c6-vd {
      left: 0;
      top: 0;
      width: 100%;
      height: 100%;
      -webkit-mask-image: linear-gradient(180deg,#000 64%,rgba(0,0,0,.15) 94%,transparent);
      mask-image: linear-gradient(180deg,#000 64%,rgba(0,0,0,.15) 94%,transparent);
    }

    /* The board image is taller than the box; its masked-out tail is clipped */
    .c6-bd {
      overflow: hidden;
    }

    .c6-bd img {
      height: auto;
      -webkit-mask-image: none;
      mask-image: none;
    }

    .c6-r1 {
      left: 47.3%;
      top: 28.868%;
      width: 7.4%;
      height: 13.774%;
    }

    .c6-r2 {
      left: 60.3%;
      top: 34.151%;
      width: 5.3%;
      height: 21.698%;
    }

    .c6-r3 {
      left: 37.2%;
      top: 34.151%;
      width: 5.2%;
      height: 21.698%;
    }

    .c6-r4,
    .c6-r5 {
      top: 47.736%;
      width: 5.3%;
      height: 22.83%;
    }

    .c6-r4 {
      left: 7.9%;
    }

    .c6-r5 {
      left: 91.2%;
    }

    .c6-halo {
      left: -3.7%;
      top: 22.83%;
      width: 11.9%;
      height: 24.151%;
    }

    .c6-slit {
      left: 2.1%;
      top: 34.151%;
      width: 1px;
      height: 2.453%;
    }

    /* Numbered tag centred above each component, revealed with the outlines */
    .c6-tag {
      display: block;
      position: absolute;
      left: var(--x);
      top: var(--y);
      padding: 2px 5px;
      border: 1px solid rgba(140,204,240,.6);
      border-radius: 4px;
      background: rgba(5,5,7,.75);
      font: 500 10px/1 'Geist Mono','Commit Mono',monospace;
      color: #4ABE18;
      opacity: 0;
      transform: translate(-50%,calc(-100% - 4px));
      transition: opacity .5s ease .6s;
    }

    .c6-sec.done .c6-tag {
      opacity: 1;
    }

    .c6-fade,
    .c6-ld,
    .c6-dots,
    .c6-fl,
    .c6-rod {
      display: none;
    }

    .c6-co {
      position: static;
      width: auto!important;
      margin-bottom: 32px;
    }

    .c6-co p {
      width: auto!important;
    }

    .c6-seg {
      position: static;
      align-self: start;
    }

    .c6-c1 {
      grid-area: a;
    }

    .c6-c2 {
      grid-area: b;
    }

    .c6-c4 {
      grid-area: c;
    }

    .c6-c3 {
      grid-area: d;
    }

    .c6-ls {
      grid-area: e;
    }

    .c6-wm {
      grid-area: f;
    }

    .c6-ft {
      position: static;
      width: auto;
      margin-top: 56px;
    }

    .c6-fl2 {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }
  }

  @media (max-width:560px) {
    .c6-st {
      grid-template-columns: 1fr;
      grid-template-areas: "m" "a" "b" "c" "e" "d" "f";
    }

    .c6-ls {
      margin-bottom: 32px;
    }
  }

  @media (prefers-reduced-motion:reduce) {
    .c6-sec * {
      transition: none!important;
      animation: none!important;
    }
  }

  .c6-sec {
    background: transparent!important;
  }

  @keyframes c6blink {
    0%,100% {
      opacity: 1;
    }
    50% {
      opacity: .45;
    }
  }

  @keyframes c6pk {
    0% {
      stroke-dashoffset: .1;
      opacity: 0;
    }
    8% {
      opacity: 1;
    }
    55% {
      stroke-dashoffset: -.92;
      opacity: 1;
    }
    62%,100% {
      stroke-dashoffset: -.92;
      opacity: 0;
    }
  }

  @keyframes c6wm {
    0%,100% {
      filter: none;
    }
    12% {
      filter: brightness(1.45);
    }
    30% {
      filter: none;
    }
  }
{% endstylesheet %}
