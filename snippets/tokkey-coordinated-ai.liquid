  }

  .c6-sec.done .c6-halo {
    opacity: 1;
  }

  .c6-sec.done .c6-slit {
    opacity: 1;
    animation: c6blink 3.2s ease-in-out 1.2s infinite;
  }

  .c6-ld {
    position: absolute;
    left: 34px;
    top: 68px;
    width: 1204px;
    height: 333px;
    overflow: visible;
  }

  .c6-ld path {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset .9s cubic-bezier(.6,0,.2,1);
  }

  .c6-sec.done .c6-ld path {
    stroke-dashoffset: 0;
  }

  .c6-sec.done .c6-ld path:nth-child(1) {
    transition-delay: .5s;
  }

  .c6-sec.done .c6-ld path:nth-child(2) {
    transition-delay: .65s;
  }

  .c6-sec.done .c6-ld path:nth-child(3) {
    transition-delay: .8s;
  }

  .c6-sec.done .c6-ld path:nth-child(4) {
    transition-delay: .95s;
  }

  .c6-dots {
    position: absolute;
    left: 725.4px;
    top: 277.5px;
    width: 429px;
    height: 125px;
    overflow: visible;
  }

  .c6-dots circle {
    opacity: 0;
    transition: opacity .4s ease;
  }

  .c6-sec.done .c6-dots circle {
    opacity: 1;
    transition-delay: 1.3s;
  }

  .c6-co {
    position: absolute;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .c6-co .t {
    display: flex;
    align-items: center;
    gap: 12px;
    font-weight: 500;
    line-height: normal;
    white-space: nowrap;
  }

  .c6-co .t em {
    font-style: normal;
    font-size: 11px;
    color: #4ABE18;
    width: 20px;
  }

  .c6-co .t b {
    font-weight: 500;
    font-size: 21px;
    color: #f2f2f2;
  }

  .c6-co p {
    margin: 0;
    font: 400 15px/24px 'Inter',sans-serif;
    color: #f2f2f2;
    opacity: .6;
    width: 240px;
  }

  .c6-c1 {
    left: 0;
    top: 55px;
    width: 205px;
  }

  .c6-c1 p {
    width: 205px;
  }

  .c6-c2 {
    left: 0;
    top: 310px;
    width: 240px;
  }

  .c6-c3 {
    left: 1276px;
    top: 55px;
    width: 240px;
  }

  .c6-c4 {
    left: 1276px;
    top: 325px;
    width: 240px;
  }

  .c6-seg {
    position: absolute;
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .c6-seg div {
    display: flex;
    gap: 5px;
  }

  .c6-seg s {
    display: block;
    width: 24px;
    height: 15px;
    border-radius: 2px;
    background: #2e2e2b;
    border: 1px solid #2e2e2b;
    opacity: 1;
    transition: opacity .35s ease,background-color .45s ease,border-color .45s ease;
  }

  .c6-wm {
    left: 1276px;
    top: 138px;
  }

  .c6-ls {
    left: 1276px;
    top: 408px;
  }

  .c6-sec.lit .c6-seg s {
    transition-delay: var(--d,0s);
  }

  .c6-sec.lit .c6-ls s.g {
    background: #4ABE18;
    border-color: #4ABE18;
    opacity: .68;
  }

  .c6-sec.lit .c6-wm s {
    background: #4ABE18;
    border-color: #4ABE18;
    opacity: var(--o,1);
  }

  .c6-rod {
    position: absolute;
    left: 1276px;
    top: 240px;
    font: 400 15px/normal 'Inter',sans-serif;
    color: #f2f2f2;
    opacity: .78;
  }

  .c6-fl {
    position: absolute;
    left: 1276px;
    top: 140px;
    width: 286px;
    height: 341px;
