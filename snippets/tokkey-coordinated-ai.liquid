  .c6-fl .hd {
    opacity: 0;
    transition: opacity .3s ease 1s;
  }

  .c6-sec.lit .c6-fl .ln {
    stroke-dashoffset: 0;
  }

  .c6-sec.lit .c6-fl .hd {
    opacity: 1;
  }

  .c6-fl .pk {
    opacity: 0;
  }

  .c6-sec.loop .c6-fl .pk {
    animation: c6pk 3.6s cubic-bezier(.5,0,.3,1) infinite;
  }

