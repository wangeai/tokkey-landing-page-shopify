{% doc %}
  Renders the "Coordinated local AI" section ported from the prototype homepage v3 (.c6-sec): a MacBook
  logic-board cutaway where an intro video plays once on first view, then callouts, memory segments and
  the "Loaded when needed" flow light up and loop. Below 1024px the board and video stack above the
  callouts; reduced motion skips straight to the end state. The intro video is read from Shopify Files
  (tk-cl6-board-intro.mp4). Behaviour lives in assets/tokkey-coordinated-ai.js.

  @example
  {% render 'tokkey-coordinated-ai' %}
{% enddoc %}

<tokkey-coordinated-ai>
<section class="c6-sec" id="clsec" aria-label="Coordinated local AI"><div class="c6-c">
  <h2 class="c6-h"><span>Run</span><b>bigger</b><b>AI</b><b>models</b><span class="c6-pill c6-pk" aria-hidden="true"><i class="c6-key"></i><i class="c6-port"></i></span><span>on</span><span>the</span><span>memory</span><span>you</span><span>already</span><span>have</span><span class="c6-pill c6-pl"><i></i>LOCAL</span></h2>
  <p class="c6-lead">Tokkey loads only the part of a model each step needs, so big AI models run on a 16GB or 24GB Mac.</p>
  <div class="c6-st">
    <div class="c6-art">
      <div class="c6-bd"><img width="940" height="604" loading="lazy" src="{{ 'tk-cl6-board.png' | asset_url }}" alt="MacBook logic board with Tokkey plugged in, cutaway — concept render"></div>
      <video class="c6-vd" id="c6v" muted playsinline preload="auto" poster="{{ 'tk-cl6-board-poster.jpg' | asset_url }}" data-src="{{ 'tk-cl6-board-intro.mp4' | file_url }}" aria-hidden="true"></video>
      <i class="c6-rim c6-r1"></i><i class="c6-rim c6-r2"></i><i class="c6-rim c6-r3"></i><i class="c6-rim c6-r4"></i><i class="c6-rim c6-r5"></i>
      <img width="119" height="128" loading="lazy" class="c6-halo" src="{{ 'tk-cl6-halo.svg' | asset_url }}" alt=""><i class="c6-slit"></i>
      {%- comment -%} Mobile-only tags; same numbers as the callouts the desktop leader lines point to {%- endcomment -%}
      <span class="c6-tag" style="--x:2.2%;--y:22.83%" aria-hidden="true">TK</span>
      <span class="c6-tag" style="--x:51%;--y:28.868%" aria-hidden="true">02</span>
      <span class="c6-tag" style="--x:39.8%;--y:34.151%" aria-hidden="true">04</span>
      <span class="c6-tag" style="--x:62.95%;--y:34.151%" aria-hidden="true">04</span>
      <span class="c6-tag" style="--x:10.55%;--y:47.736%" aria-hidden="true">03</span>
      <span class="c6-tag" style="--x:93.85%;--y:47.736%" aria-hidden="true">03</span>
    </div>
    <div class="c6-fade"></div>
    <svg class="c6-ld" viewBox="0 0 1204 333" fill="none" aria-hidden="true">
      <path pathLength="1" opacity=".55" d="M1 83V111.286H206V170" stroke-width="2" stroke="#BDD9EE"/>
      <path pathLength="1" opacity=".55" d="M695 212V258H100" stroke-width="2" stroke="#BDD9EE"/>
      <path pathLength="1" opacity=".55" d="M818 212V1H1240" stroke-width="2" stroke="#BDD9EE"/>
      <path pathLength="1" opacity=".45" d="M1240 270H1226.51V332H1119" stroke-width="2" stroke="#BDD9EE"/>
    </svg>
    <svg class="c6-dots" viewBox="0 0 429 125" aria-hidden="true"><circle cx="2.5" cy="2.5" r="2.5" fill="#CEE6F5"/><circle cx="122.5" cy="49.5" r="2.5" fill="#CEE6F5"/><circle cx="426.5" cy="122.5" r="2.5" fill="#CEE6F5"/></svg>
    <div class="c6-co c6-c1"><div class="t"><em>TK</em><b>Tokkey</b></div><p>Decides what runs where<br>on your Mac.</p></div>
    <div class="c6-co c6-c2"><div class="t"><em>02</em><b>Compute</b></div><p>Your Mac’s chip does<br>the AI work.</p></div>
    <div class="c6-co c6-c3"><div class="t"><em>04</em><b>Working memory</b></div><p>Holds just the part in use.</p></div>
    <div class="c6-co c6-c4"><div class="t"><em>03</em><b>Local storage</b></div><p>Stores the whole model.</p></div>
    <div class="c6-seg c6-wm" aria-hidden="true"><div><s style="--i:0;--o:1;--d:0.00s"></s><s style="--i:1;--o:0.96;--d:0.06s"></s><s style="--i:2;--o:0.91;--d:0.12s"></s><s style="--i:3;--o:0.87;--d:0.18s"></s><s style="--i:4;--o:0.82;--d:0.24s"></s><s style="--i:5;--o:0.78;--d:0.30s"></s></div></div>
    <div class="c6-seg c6-ls" aria-hidden="true"><div><s style="--d:0.00s"></s><s style="--d:0.02s"></s><s style="--d:0.04s"></s><s style="--d:0.06s"></s><s style="--d:0.08s"></s><s style="--d:0.10s"></s><s style="--d:0.12s"></s><s style="--d:0.14s"></s></div><div><s style="--d:0.16s"></s><s class="g" style="--d:0.18s"></s><s class="g" style="--d:0.20s"></s><s class="g" style="--d:0.22s"></s><s class="g" style="--d:0.24s"></s><s class="g" style="--d:0.26s"></s><s class="g" style="--d:0.28s"></s><s style="--d:0.30s"></s></div><div><s style="--d:0.32s"></s><s style="--d:0.34s"></s><s style="--d:0.36s"></s><s style="--d:0.38s"></s><s style="--d:0.40s"></s><s style="--d:0.42s"></s><s style="--d:0.44s"></s><s style="--d:0.46s"></s></div><div><s style="--d:0.48s"></s><s style="--d:0.50s"></s><s style="--d:0.52s"></s><s style="--d:0.54s"></s><s style="--d:0.56s"></s><s style="--d:0.58s"></s><s style="--d:0.60s"></s><s style="--d:0.62s"></s></div></div>
    <p class="c6-rod">Loaded when needed</p>
    <svg class="c6-fl" viewBox="0 0 286 341" fill="none" aria-hidden="true">
      <path class="ln" pathLength="1" opacity=".55" d="M227 296H249C256.333 296 260 291.194 260 281.581V19.4189C260 9.80631 256.333 5 249 5H169" stroke-width="2" stroke="#4ABE18"/>
      <path class="hd" d="M260 136V159" stroke-width="2" stroke="#BDEFA5"/>
      <path class="hd" d="M175 1L169 5L175 9" stroke-width="1.2" stroke="#BDEFA5"/>
      <path class="pk" pathLength="1" stroke-dasharray=".1 1.2" d="M227 296H249C256.333 296 260 291.194 260 281.581V19.4189C260 9.80631 256.333 5 249 5H169" stroke-width="2.4" stroke="#DFFFCB" stroke-linecap="round"/>
    </svg>
  </div>
</div></section>
</tokkey-coordinated-ai>

<script src="{{ 'tokkey-coordinated-ai.js' | asset_url }}" defer></script>

{% stylesheet %}
  /* Ported from the prototype homepage v3; a 1920px design canvas scaled by --z below 1920px */
  tokkey-coordinated-ai {
    display: block;
    line-height: normal;
  }

  .c6-sec {
    --z: 1;
    position: relative;
    height: calc(1100px * var(--z));
    background: #000;
    overflow: hidden;
    color: #f2f2f2;
  }

  .c6-c {
    position: absolute;
    left: 50%;
    top: calc(20px * var(--z));
    width: 1920px;
    height: 1046px;
    transform: translateX(-50%) scale(var(--z));
    transform-origin: top center;
    font-family: 'Inter',sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  .c6-c * {
    box-sizing: border-box;
  }

  .c6-h {
    position: absolute;
    left: 179px;
    top: 120px;
    width: 932px;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 14.616px;
    font: 300 62.638px/76.21px 'Geist','Inter',sans-serif;
    letter-spacing: -1.8792px;
    color: #808080;
  }

  .c6-h span {
    white-space: nowrap;
  }

  .c6-h b {
    font-weight: 600;
    color: #fff;
    white-space: nowrap;
  }

  .c6-w {
    display: inline-flex;
    align-items: center;
    gap: inherit;
    font-style: normal;
  }

  .c6-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 39.671px;
    border-radius: 103.353px;
    background: rgba(255,255,255,.06);
    border: 1.044px solid rgba(255,255,255,.2);
    overflow: hidden;
  }

  .c6-pk {
    width: 66.814px;
    gap: 4.176px;
    padding: 0 8.352px;
  }

  .c6-key {
    position: relative;
    width: 35.495px;
    height: 29.231px;
    border-radius: 5.22px;
    background: #e9e9ec;
    flex: none;
  }

  .c6-key::after {
    content: '';
    position: absolute;
    left: 7.31px;
    top: 9.4px;
    width: 3.132px;
    height: 10.44px;
    border-radius: 1.044px;
    background: #111;
  }

  .c6-port {
    width: 14.616px;
    height: 10.44px;
    border-radius: 3.132px;
    background: #55555a;
    flex: none;
  }

  .c6-pl {
    gap: 10.44px;
    padding: 0 14.616px;
    font: 500 25.055px/1 'Geist Mono','Commit Mono',monospace;
    letter-spacing: .5011px;
    color: #fff;
  }

  .c6-pl i {
    width: 14.616px;
    height: 14.616px;
    border-radius: 50%;
    background: #4ABE18;
    flex: none;
  }

  .c6-lead {
    position: absolute;
    left: 179px;
    top: 296px;
    width: 1562px;
    margin: 0;
    font: 400 21px/32px 'Inter',sans-serif;
    color: #f2f2f2;
    opacity: .72;
  }

  .c6-st {
    position: absolute;
    left: 179px;
    top: 353px;
    width: 1562px;
    height: 620px;
    overflow: hidden;
  }

  /* Board art layer; on desktop it covers the stage so child coordinates are unchanged */
  .c6-art {
    position: absolute;
    inset: 0;
  }

  .c6-tag {
    display: none;
  }

  .c6-bd {
    position: absolute;
    left: 218px;
    top: 90px;
    width: 1000px;
    height: 642.553px;
  }

  .c6-bd img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    opacity: 0;
    transition: opacity 1.1s ease;
  }

  .c6-vd {
    position: absolute;
    left: 218px;
    top: 90px;
    width: 1000px;
    height: 530px;
    object-fit: fill;
    opacity: 1;
    transition: opacity 1.1s ease;
    pointer-events: none;
  }

  .c6-sec.done .c6-bd img {
    opacity: 1;
  }

  .c6-sec.done .c6-vd {
    opacity: 0;
  }

  .c6-fade {
    display: none;
  }

  .c6-bd img,
  .c6-vd {
    -webkit-mask-image: linear-gradient(180deg,#000 340px,rgba(0,0,0,.15) 500px,transparent 530px);
    mask-image: linear-gradient(180deg,#000 340px,rgba(0,0,0,.15) 500px,transparent 530px);
  }

  .c6-bd img,
  .c6-vd {
    mix-blend-mode: screen;
  }

  .c6-rim {
    position: absolute;
    border-radius: 4px;
    opacity: 0;
    transform: scale(1.06);
    transition: opacity .6s ease,transform .8s cubic-bezier(.2,.7,.2,1);
  }

  .c6-r1 {
    left: 691px;
    top: 243px;
    width: 74px;
    height: 73px;
    border: 1.8px solid rgba(140,204,240,.95);
    box-shadow: 0 0 4px rgba(255,255,255,.25);
  }

  .c6-r2 {
    left: 821px;
    top: 271px;
    width: 53px;
    height: 115px;
    border: 1.5px solid #8cccf0;
    box-shadow: 0 0 4px rgba(255,255,255,.25);
  }

  .c6-r3 {
    left: 590px;
    top: 271px;
    width: 52px;
    height: 115px;
    border: 1.5px solid rgba(140,204,240,.9);
    box-shadow: 0 0 4px rgba(255,255,255,.25);
  }

  .c6-r4,
  .c6-r5 {
    top: 343px;
