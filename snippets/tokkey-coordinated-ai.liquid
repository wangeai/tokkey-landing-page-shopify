    height: 121px;
    border: 1.25px solid rgba(122,179,212,.7);
    box-shadow: 0 0 19px rgba(102,176,227,.22),0 0 8px rgba(92,165,214,.36);
  }

  .c6-r4 {
    left: 297px;
  }

  .c6-r5 {
    left: 1130px;
  }

  .c6-sec.done .c6-rim {
    opacity: 1;
    transform: none;
  }

  .c6-sec.done .c6-r1 {
    transition-delay: .15s;
  }

  .c6-sec.done .c6-r2,
  .c6-sec.done .c6-r3 {
