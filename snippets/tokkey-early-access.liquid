{% doc %}
  Renders the "Get updates" early-access card ported from the prototype homepage v3 (.eb-sec).
  Its button links to the deposit reservation product.

  @example
  {% render 'tokkey-early-access' %}
{% enddoc %}

<section class="eb-sec" id="ebsec" aria-label="Get updates">
  <div class="eb-card">
    <div class="eb-txt">
      <div class="eb-eye"><i></i>EARLY ACCESS</div>
      <h3 class="eb-h">Be first to try Tokkey<span>.</span></h3>
    </div>
    <a class="eb-btn" href="/products/tokkey-deposit-reservation">Reserve your spot</a>
  </div>
</section>

{% stylesheet %}
  /* "Get updates" card (prototype homepage v3 .eb-sec) */
  .eb-sec {
    line-height: normal;
    --eb-sp: min(140px, 7.2917vw);
    padding: var(--eb-sp) 0;
    font-family: Inter, sans-serif;
  }

  .eb-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 48px;
    width: min(81.354vw, 1562px);
    margin: 0 auto;
    padding: 40px;
    border: 1px solid #2e2e2b;
    border-radius: 24px;
    background: rgb(20 20 19 / 0.72);
    backdrop-filter: blur(18px);
  }

  .eb-eye {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 16px;
    font: 500 13px/16px 'Geist Mono', monospace;
    letter-spacing: 0.06em;
    color: #8e8e93;
  }

  .eb-eye i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #4abe18;
  }

  .eb-h {
    margin: 0;
    font: 600 40px/48px Geist, Inter, sans-serif;
    letter-spacing: -0.025em;
    color: #fff;
  }

  .eb-h span {
    color: #4abe18;
  }

  /* Deposit CTA, styled like the former Subscribe button */
  .eb-btn {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    height: 56px;
    padding: 0 32px;
    border-radius: 16px;
    background: #fff;
    font: 600 16px Inter, sans-serif;
    color: #000;
    text-decoration: none;
  }

  .eb-btn:hover {
    opacity: 0.88;
  }

  .eb-btn:focus-visible {
    outline: 2px solid #4abe18;
    outline-offset: 2px;
  }

  @media (max-width: 1023px) {
    .eb-sec {
      --eb-sp: 80px;
      padding: var(--eb-sp) 24px;
    }

    .eb-card {
      flex-direction: column;
      align-items: stretch;
      gap: 28px;
      width: auto;
      padding: 32px 24px;
    }

    .eb-h {
      font-size: 32px;
    }
  }
{% endstylesheet %}
