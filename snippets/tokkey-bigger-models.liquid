{% doc %}
  Renders the "Bigger models on the same Mac" section ported from the prototype homepage v3 (.s2-sec):
  a headline whose numbers roll between 16GB and 48GB, a memory toggle, and a deck of model cards.
  On desktop the section pins while scrolling and switches to 48GB past its midpoint; below 1024px it
  stacks, and the deck fans out (scaled by the script) over the left of the laptop, as on desktop. Behaviour lives in assets/tokkey-bigger-models.js.

  @example
  {% render 'tokkey-bigger-models' %}
{% enddoc %}

<section aria-label="Bigger models on the same Mac">
  <tokkey-bigger-models class="s2-sec" data-s="0">
    <div class="s2-c">
      <div class="s2-macro"><picture><source media="(max-width: 768px)" srcset="{{ 'tk-s2-macro-m.webp' | asset_url }}"><img src="{{ 'tk-s2-macro.webp' | asset_url }}" width="1680" height="1164" alt="Tokkey plugged into a MacBook. Concept render" loading="lazy"></picture></div>
      <div class="s2-glow"></div>
      <div class="s2-hair"><i></i></div>
      <h2 class="s2-h"><span>A</span><span>key</span><span class="s2-pill s2-pk" aria-hidden="true"><i></i><u></u></span><span>that</span><span>runs</span><span class="s2-roll" aria-live="polite"><span><b>35B</b><b>125B</b></span></span><b>AI</b><b>models</b><i class="s2br"></i><span>on</span><span>a</span><span class="s2-roll"><span><b>16GB</b><b>48GB</b></span></span><span>Mac.</span><span class="s2-pill s2-pl">LOCAL</span></h2>
