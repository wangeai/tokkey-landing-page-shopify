{% doc %}
  Renders the Software page features story (Figma: Software · D · 02_agent_hub → 06_router, nodes 1163:63–67),
  ported from SoftwareFeatures.astro in the tokkey-landing-page repo: five chapters on paper (#fafaf7) over a faint
  ambient character field. From 1200px the copy scrolls on the left while the matching UI preview stays pinned on
  the right and cross-fades per chapter, with a chapter bar pinned to the bottom of the viewport; below 1200px each
  chapter stacks its copy above its preview. Preview sizes are Figma px via --ux (= --fx when pinned, the column
  width / 960 when stacked). Behaviour: TokkeySoftwareFeatures in assets/tokkey-software.js (loaded by
  sections/tokkey-software.liquid). All rules are scoped under .tk-swf.

  @example
  {% render 'tokkey-software-features' %}
{% enddoc %}

{%- liquid
  # Chapter ids and chapter bar labels, in story order
  assign chapter_ids = 'agent-hub,private-chat,no-ai-credits,your-workflow,router' | split: ','
  assign chapter_navs = 'Agent Hub,Private Chat,No AI Credits,Your workflow,Router' | split: ','
  assign local_tasks = 'Document summarized,Draft rewritten,Follow-up answered' | split: ','
-%}

<tokkey-software-features>
  <section id="features" class="tk-swf" aria-label="What Tokkey does">
    {%- comment -%} Ambient field: one viewport tall, sticks while the story scrolls (prototype `fxAmb`) {%- endcomment -%}
    <canvas class="ambient" data-ref="ambient" aria-hidden="true"></canvas>

    <div class="story">
      {%- comment -%} Chapters: copy (and, below 1200px, the chapter's preview moved into its slot) {%- endcomment -%}
      <div>
        {% render 'tokkey-software-chapter',
          id: 'agent-hub',
          label: 'Agent Hub',
          lead: 'Your agents.',
          emphasis: 'Powered locally.',
          text: 'Connect compatible agents to Tokkey’s local <br>models. Pick your tool, check its connection, <br>and start working.'
        %}
        {% render 'tokkey-software-chapter',
          id: 'private-chat',
          label: 'Private Chat',
          lead: 'A conversation,',
          emphasis: 'just for you.',
          text: 'Think, write, and work with your files. <br>All on your Mac.',
          note: 'Processed on your Mac. Tool network access off.',
          note_lock: true
        %}
        {% render 'tokkey-software-chapter',
          id: 'no-ai-credits',
          label: 'No AI Credits',
          lead: 'Keep creating.',
          emphasis: 'Skip the top-ups.',
          text: 'Write, ask, and repeat with local AI. <br>No cloud credits needed for those tasks.',
          note: 'Optional cloud use is billed separately.'
        %}
        {% render 'tokkey-software-chapter',
          id: 'your-workflow',
          label: 'Your existing workflow',
          lead: 'Same tools.',
          emphasis: 'Powered locally.',
          text: 'Choose a Tokkey local model in your <br>compatible AI tool. Keep working where you <br>already are.',
          note: 'Tokkey works quietly in the background.'
        %}
        {% render 'tokkey-software-chapter',
          id: 'router',
          label: 'Router',
          lead: 'Local power.',
          emphasis: 'Cloud by choice.',
          text: 'Router matches each task to local or cloud AI. <br>Keep private work on your Mac, and control <br>what cloud models receive.',
          note: 'See the route. Control what leaves.',
          note_lock: true
        %}
      </div>

      {%- comment -%} Pinned preview column (from 1200px): the five previews stacked, the active one shown {%- endcomment -%}
      <div class="pin">
        <div class="host" data-ref="host">
          {%- comment -%} 01 Agent Hub; icon layers sit at Figma offsets inside a 40×40 box {%- endcomment -%}
          <div class="stage s-hub" data-ref="stage" style="--h:720" role="group" aria-label="Agent Hub preview: Codex selected and connected to Tokkey, running Qwen3.5 9B on this Mac">
            <div class="atm" aria-hidden="true"></div>
            <div class="ui">
              <div class="row hub-hd"><b>Agent Hub</b><span>Choose an agent</span></div>
              <div class="hub-opts" role="tablist" aria-label="Choose an agent">
                <button type="button" class="hub-opt is-on" role="tab" data-ref="agent" data-agent="Codex" aria-selected="true" tabindex="0">
                  <span class="hub-icon" aria-hidden="true">
                    <img src="{{ 'tk-sw-agent-codex.svg' | asset_url }}" width="29" height="31" alt="" style="left:calc(5.49*var(--ux));top:calc(4.59*var(--ux));width:calc(29.0039*var(--ux));height:calc(30.81*var(--ux))">
                  </span>
                  <b>Codex</b>
                  <span>Code &amp; build</span>
                </button>
                <button type="button" class="hub-opt" role="tab" data-ref="agent" data-agent="Claude Code" aria-selected="false" tabindex="-1">
                  <span class="hub-icon" aria-hidden="true">
                    <img src="{{ 'tk-sw-agent-claude-code.svg' | asset_url }}" width="33" height="33" alt="" style="left:calc(3.71*var(--ux));top:calc(3.71*var(--ux));width:calc(32.57*var(--ux));height:calc(32.57*var(--ux))">
                  </span>
                  <b>Claude Code</b>
                  <span>Code &amp; debug</span>
                </button>
                <button type="button" class="hub-opt" role="tab" data-ref="agent" data-agent="OpenClaw" aria-selected="false" tabindex="-1">
                  <span class="hub-icon" aria-hidden="true">
                    <img src="{{ 'tk-sw-agent-openclaw-body.svg' | asset_url }}" width="30" height="20" alt="" style="left:calc(4.85*var(--ux));top:calc(8.6*var(--ux));width:calc(30.3*var(--ux));height:calc(20.397*var(--ux))">
                    <img src="{{ 'tk-sw-agent-openclaw-eyes.svg' | asset_url }}" width="13" height="5" alt="" style="left:calc(13.55*var(--ux));top:calc(16.85*var(--ux));width:calc(12.9*var(--ux));height:calc(4.8*var(--ux))">
                  </span>
                  <b>OpenClaw</b>
                  <span>Automate tasks</span>
                </button>
              </div>
              <div class="hr"></div>
              <div class="row hub-sel">
                <div>
                  <b data-ref="agent-name">Codex</b>
                  <span class="status"><i class="dot"></i>Connected to Tokkey</span>
                </div>
                <span class="hub-btn" data-ref="agent-open">Open Codex ↗</span>
              </div>
              <div class="hub-model">
                <div class="grow"><small>LOCAL MODEL</small><b>Qwen3.5 9B</b></div>
                <span class="loc"><i class="dot"></i>On this Mac</span>
                <span class="chev" aria-hidden="true">⌄</span>
              </div>
            </div>
          </div>

          {%- comment -%} 02 Private Chat {%- endcomment -%}
          <div class="stage s-chat" data-ref="stage" style="--h:600" role="group" aria-label="Private Chat preview in local-only mode: a question about Client proposal.pdf answered on the Mac">
            <div class="atm" aria-hidden="true"></div>
            <div class="ui">
              <div class="row">
                <span class="ttl">Private Chat</span>
                <span class="pill"><img class="pill-icon" src="{{ 'tk-sw-lock-pill.svg' | asset_url }}" width="14" height="14" alt="">Local-only</span>
              </div>
              <div class="chat-q">
                <span class="doc"><img src="{{ 'tk-sw-doc.svg' | asset_url }}" width="19" height="19" alt="">Client proposal.pdf</span>
                <p>What are the key points in this proposal?</p>
              </div>
              <div class="chat-a">
                <b>Here’s the short version.</b>
                <p>A six-week project, two review rounds, and a final handoff.<br>The next step is to agree on the scope and deliverables.</p>
              </div>
              <div class="hr"></div>
              <div class="row chat-in">
                <span class="ph">Ask a follow-up…</span>
                <span class="chat-meta">
                  <span class="lm"><i class="dot dot-6"></i>Local model</span>
                  <span class="send send-32"><img src="{{ 'tk-sw-send.svg' | asset_url }}" width="18" height="18" alt=""></span>
                </span>
              </div>
            </div>
          </div>

          {%- comment -%} 03 No AI Credits {%- endcomment -%}
          <div class="stage s-zero" data-ref="stage" style="--h:640" role="group" aria-label="Local activity preview: 0 cloud credits used across three tasks completed locally">
            <div class="atm" aria-hidden="true"></div>
            <div class="ui">
              <div class="row">
                <span class="ttl">Local activity</span>
                <span class="pill"><i class="dot dot-6"></i>On this Mac</span>
              </div>
              <div class="zero">
                <span class="n">0</span>
                <div><b>Cloud credits used</b><span>Across these local tasks.</span></div>
              </div>
              <div class="hr"></div>
              <ol class="acts">
                {%- for task in local_tasks %}
                  <li class="act">
                    <i>0{{ forloop.index }}</i>
                    <span>{{ task }}</span>
                    <em>Completed locally</em>
                  </li>
                {%- endfor %}
              </ol>
              <div class="hr"></div>
              <div class="row zero-ft"><span>Ready for your next task.</span><b>No per-token API fee</b></div>
            </div>
          </div>

          {%- comment -%}
            04 Your existing workflow: each model option carries the API note shown for it (TokkeySoftwareFeatures)
          {%- endcomment -%}
          <div class="stage s-flow" data-ref="stage" style="--h:640" role="group" aria-label="Codex composer preview with the model menu open: Tokkey local model selected">
            <div class="atm" aria-hidden="true"></div>
            <div class="ui comp">
              <div class="comp-hd"><b>Codex</b><span>/ &nbsp;your-project</span></div>
              <p class="msg">Review the changes in this project and suggest a fix.</p>
              <div class="row">
                <button type="button" class="sel" data-ref="model-toggle" aria-expanded="true" aria-controls="features-model-menu">
                  <span data-ref="model-current">Tokkey · Local model</span>
                  <img src="{{ 'tk-sw-chevron.svg' | asset_url }}" width="18" height="18" alt="">
                </button>
                <span class="send send-34"><img src="{{ 'tk-sw-send.svg' | asset_url }}" width="18" height="18" alt=""></span>
              </div>
            </div>
            <div class="ui menu" id="features-model-menu" data-ref="model-menu">
              <span class="cap">Choose a model</span>
              <button
                type="button"
                class="opt is-on"
                data-ref="model"
                data-name="Tokkey · Local model"
                data-api="Tokkey local API"
                data-api-text="Connected in the background."
                data-api-note="No per-token API fee for local runs."
                aria-pressed="true"
              >
                <span class="grow"><b>Tokkey · Local model</b><span>On your Mac · via local API</span></span>
                <img class="check" src="{{ 'tk-sw-check.svg' | asset_url }}" width="20" height="20" alt="">
              </button>
              <button
                type="button"
                class="opt"
                data-ref="model"
                data-name="Cloud model"
                data-api="Your cloud provider"
                data-api-text="Uses your configured cloud connection."
                data-api-note="Your provider’s charges apply."
                aria-pressed="false"
              >
                <span class="grow"><b>Cloud model</b><span>Your configured provider</span></span>
                <img class="check" src="{{ 'tk-sw-check.svg' | asset_url }}" width="20" height="20" alt="">
              </button>
            </div>
            <div class="api" aria-live="polite">
              <b><i class="dot dot-6"></i><span data-ref="api-name">Tokkey local API</span></b>
              <span data-ref="api-text">Connected in the background.</span>
              <small data-ref="api-note">No per-token API fee for local runs.</small>
            </div>
          </div>

          {%- comment -%} 05 Router {%- endcomment -%}
          <div class="stage s-route" data-ref="stage" style="--h:740" role="group" aria-label="Router preview: a task goes either to Local AI on your Mac or to Cloud AI after you review what is shared">
            <div class="atm" aria-hidden="true"></div>
            <div class="stem" aria-hidden="true"></div>
            <img class="fork" src="{{ 'tk-sw-fork.svg' | asset_url }}" width="504" height="98" alt="" aria-hidden="true">
            <div class="ui task"><small>YOUR TASK</small><p>Help me refine this launch plan.</p></div>
            <div class="ui node">
              <img src="{{ 'tk-sw-router.svg' | asset_url }}" width="24" height="24" alt="">
              <div><b>Router</b><span>Matches task to model</span></div>
            </div>
            <div class="ui opt-card is-local">
              <div class="who"><img src="{{ 'tk-sw-lock-local.svg' | asset_url }}" width="20" height="20" alt="">Local AI</div>
              <p class="for">For private &amp; everyday work.</p>
              <div class="box"><small>RUNS ON</small><b>Your Mac</b></div>
              <p class="nt">Prompts and files processed here.</p>
              <span class="do">On-device processing</span>
            </div>
            <div class="ui opt-card is-cloud">
              <div class="who"><img src="{{ 'tk-sw-cloud.svg' | asset_url }}" width="20" height="20" alt="">Cloud AI</div>
              <p class="for">For more demanding tasks.</p>
              <div class="box"><small>CONTEXT TO SHARE</small><b>Selected summary</b></div>
              <p class="nt">Review before anything is sent.</p>
              <span class="do">Review &amp; continue →</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    {%- comment -%} Chapter bar (from 1200px): sticks to the bottom of the viewport while the story is on screen {%- endcomment -%}
    <nav class="bar" data-ref="bar" aria-label="Feature chapters">
      <span class="count"><b data-ref="count">01</b><i>/</i>0{{ chapter_ids.size }}</span>
      <div class="links">
        {%- for chapter_id in chapter_ids %}
          <a href="#{{ chapter_id }}" data-ref="bar-link"{% if forloop.first %} class="is-on"{% endif %}>
            <span class="line"></span>
            {{- chapter_navs[forloop.index0] -}}
          </a>
        {%- endfor %}
      </div>
      <span class="cue">Scroll <i aria-hidden="true">↓</i></span>
    </nav>
  </section>
</tokkey-software-features>

{% stylesheet %}
  tokkey-software-features {
    display: block;
  }

  /* Element resets the Astro source got from Tailwind's preflight */
  .tk-swf *,
  .tk-swf *::before,
  .tk-swf *::after {
    box-sizing: border-box;
  }
  .tk-swf p,
  .tk-swf h2,
  .tk-swf ol {
    margin: 0;
    padding: 0;
  }
  .tk-swf ol {
    list-style: none;
  }
  .tk-swf img {
    display: block;
    max-width: 100%;
  }
  .tk-swf button {
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
  }
  .tk-swf a {
    color: inherit;
    text-decoration: none;
  }
  /* " <br>" in the copy marks Figma's line breaks, kept from 1200px */
  @media (max-width: 1199px) {
    .tk-swf .text br {
      display: none;
    }
  }

  /* Below 1200px copy and preview fade up as the chapter enters (TokkeySoftwareFeatures.reveal) */
  .tk-swf .is-reveal {
    opacity: 0;
    transform: translateY(26px);
    transition:
      opacity 0.9s var(--ease),
      transform 0.9s var(--ease);
  }
  .tk-swf .is-reveal.is-revealed {
    opacity: 1;
    transform: none;
  }

  /* Figma palette for this section (paper, ink, muted, hairline, badge, sage accent, bubble, faint) */
  .tk-swf {
    --paper: #fafaf7;
    --ink: #282c29;
    --muted: #747a77;
    --line: #e6e9e4;
    --badge: #eff3ea;
    --sage: #536e50;
    --bubble: #f1f3f0;
    --faint: #a0a6a1;
    --ease: cubic-bezier(0.22, 1, 0.36, 1);
    position: relative;
    background: var(--paper);
    color: var(--ink);
    overflow-x: clip;
  }
  .tk-swf .ambient {
    position: sticky;
    top: 0;
    display: block;
    width: 100%;
    height: 100vh;
    margin-bottom: -100vh;
    pointer-events: none;
  }
  .tk-swf .story {
    position: relative;
  }

  /* ───── Copy ───── */
  .tk-swf .copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .tk-swf .eyebrow {
    color: var(--muted);
    font-family: var(--tk-sw-mono);
    font-size: 12px;
    line-height: 16px;
    font-weight: 500;
    letter-spacing: 1px;
    text-transform: uppercase;
  }
  .tk-swf .title {
    margin-top: 20px;
    color: rgb(40 44 41 / 55%);
    font-size: 36px;
    line-height: 40px;
    font-weight: 400;
    letter-spacing: -0.03em;
  }
  .tk-swf .title em {
    color: var(--ink);
    font-style: normal;
    font-weight: 500;
  }
  .tk-swf .text {
    margin-top: 20px;
    max-width: 520px;
    color: var(--muted);
    font-size: 18px;
    line-height: 27px;
  }
  .tk-swf .note {
    display: flex;
    align-items: center;
    gap: 9px;
    margin-top: 28px;
    color: var(--muted);
    font-size: 14px;
    line-height: 20px;
  }
  .tk-swf .note img {
    flex: none;
    width: 15px;
    height: 15px;
  }

  /* ───── Stacked layout (below 1200px): copy, then the chapter's preview at the column width ───── */
  .tk-swf .chapter {
    padding: 64px 16px;
  }
  .tk-swf .slot {
    container-type: inline-size;
    margin-top: 24px;
  }
  .tk-swf .pin,
  .tk-swf .bar {
    display: none;
  }
  @media (min-width: 768px) {
    .tk-swf .chapter {
      padding: 96px 40px;
    }
    .tk-swf .title {
      font-size: 48px;
      line-height: 52px;
    }
  }

  /* ───── Pinned story (from 1200px): copy column 560 + gap 80 + preview column 1024, centred (x = 128 on 1920) ───── */
  @media (min-width: 1200px) {
    /* Pull the story up under the hero's fade (160 of 1080) so chapter 1 sits centred once the hero has gone */
    .tk-swf .ambient {
      margin-bottom: calc(-100vh - 14.815vh);
    }
    .tk-swf .story {
      display: grid;
      grid-template-columns: calc(560 * var(--fx)) calc(1024 * var(--fx));
      column-gap: calc(80 * var(--fx));
      justify-content: center;
    }
    .tk-swf .chapter {
      display: flex;
      align-items: center;
      height: 100vh;
      min-height: 620px;
      padding: 0;
    }
    .tk-swf .slot {
      display: none;
    }
    .tk-swf .copy {
      opacity: var(--copy-opacity, 1);
      will-change: opacity;
    }
    .tk-swf .title {
      margin-top: calc(28 * var(--fx));
      font-size: calc(63.9 * var(--fx));
      line-height: calc(67.1 * var(--fx));
      letter-spacing: calc(-1.9 * var(--fx));
    }
    .tk-swf .eyebrow {
      font-size: max(11px, calc(12 * var(--fx)));
    }
    .tk-swf .text {
      margin-top: calc(28 * var(--fx));
      max-width: none;
      font-size: calc(24 * var(--fx));
      line-height: calc(33.6 * var(--fx));
    }
    .tk-swf .note {
      margin-top: calc(40 * var(--fx));
      font-size: max(12px, calc(14 * var(--fx)));
    }
    .tk-swf .pin {
      position: sticky;
      top: 0;
      display: flex;
      align-items: center;
      align-self: start;
      height: 100vh;
      min-height: 620px;
    }
    .tk-swf .host {
      position: relative;
      width: calc(1024 * var(--fx));
      height: calc(740 * var(--fx));
    }
  }

  /* ───── Preview stages: Figma px via --ux ───── */
  .tk-swf .stage {
    --ux: calc(100cqw / 960);
    position: relative;
    width: calc(1024 * var(--ux));
    height: calc(var(--h) * var(--ux));
    /* The card sits 32 in from the stage's left edge; line it up with the copy column */
    margin-left: calc(-32 * var(--ux));
  }
  @media (min-width: 1200px) {
    /* All five stacked in the pinned column, centred; only the active one shows (FeatureStoryScene) */
    .tk-swf .host .stage {
      --ux: var(--fx);
      position: absolute;
      top: 50%;
      left: 0;
      margin: calc(var(--h) * var(--ux) / -2) 0 0;
      opacity: 0;
      visibility: hidden;
      transform: translateY(25px) scale(0.985);
      transition:
        opacity 0.65s var(--ease),
        transform 0.85s var(--ease),
        visibility 0.85s;
    }
    .tk-swf .host .stage.is-active {
      z-index: 2;
      opacity: 1;
      visibility: visible;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .tk-swf .host .stage {
      transform: none;
      transition: none;
    }
  }

  /* Soft grey glow under each card (Figma .atm) */
  .tk-swf .atm {
    position: absolute;
    border-radius: 50%;
    background: #dfe0dc;
    filter: blur(calc(44 * var(--ux)));
    pointer-events: none;
  }
  .tk-swf .ui {
    position: absolute;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--line);
    background: #fff;
    box-shadow: 0 calc(14 * var(--ux)) calc(44 * var(--ux)) rgb(40 44 41 / 6%);
  }
  .tk-swf .hr {
    flex: none;
    align-self: stretch;
    height: 1px;
    background: var(--line);
  }
  .tk-swf .row {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .tk-swf .grow {
    flex: 1;
  }
  .tk-swf .dot {
    flex: none;
    width: calc(5 * var(--ux));
    height: calc(5 * var(--ux));
    border-radius: 50%;
    background: var(--sage);
  }
  .tk-swf .dot-6 {
    width: calc(6 * var(--ux));
    height: calc(6 * var(--ux));
  }
  .tk-swf .ttl {
    font-size: calc(17 * var(--ux));
    line-height: calc(23.8 * var(--ux));
    font-weight: 500;
  }
  .tk-swf .pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: calc(7 * var(--ux));
    border-radius: calc(100 * var(--ux));
    background: var(--badge);
    color: var(--sage);
    font-size: calc(12 * var(--ux));
    line-height: calc(16.8 * var(--ux));
    font-weight: 500;
  }
  .tk-swf .pill-icon {
    width: calc(14 * var(--ux));
    height: calc(14 * var(--ux));
  }
  .tk-swf .send {
    display: grid;
    flex: none;
    place-items: center;
    border-radius: calc(7 * var(--ux));
    background: var(--ink);
  }
  .tk-swf .send img {
    width: calc(18 * var(--ux));
    height: calc(18 * var(--ux));
  }
  .tk-swf .send-32 {
    width: calc(32 * var(--ux));
    height: calc(32 * var(--ux));
  }
  .tk-swf .send-34 {
    width: calc(34 * var(--ux));
    height: calc(34 * var(--ux));
  }
  .tk-swf .stage button {
    cursor: pointer;
    text-align: inherit;
  }
  .tk-swf .stage button:focus-visible,
  .tk-swf .bar a:focus-visible {
    outline: 2px solid var(--sage);
    outline-offset: 2px;
  }

  /* 01 Agent Hub (card 960×520 at 800,280 on the 1920 frame) */
  .tk-swf .s-hub .atm {
    left: calc(92 * var(--ux));
    top: calc(180 * var(--ux));
