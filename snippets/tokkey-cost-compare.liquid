{% stylesheet %}
  /* Ported from the prototype homepage v3; a 1920px design canvas scaled by --z below 1920px */
  tokkey-cost-compare {
    display: block;
    line-height: normal;
  }

  .s3-sec {
    --z: 1;
    position: relative;
    height: calc(1753px * var(--z));
    background: #000;
    overflow: hidden;
    color: #f2f2f2;
  }

  .s3-c {
    position: absolute;
    left: 50%;
    top: calc(11px * var(--z));
    width: 1920px;
    height: 1753px;
    transform: translateX(-50%) scale(var(--z));
    transform-origin: top center;
    font-family: 'Inter',sans-serif;
  }

  .s3-mono {
    font: 500 13px/16px 'Geist Mono','Commit Mono',monospace;
    letter-spacing: .06em;
    color: #8e8e93;
    text-transform: uppercase;
  }

  .s3-h {
    position: absolute;
    left: 179px;
    top: 132px;
    margin: 0;
    font-family: 'Geist','Inter',sans-serif;
    font-size: 62.638px;
    line-height: 76.21px;
    letter-spacing: -1.8792px;
    font-weight: 300;
    color: #808080;
    white-space: nowrap;
  }

  .s3-h {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 14.616px;
    width: 1562px;
  }

  .s3-h b {
    font-weight: 600;
    color: #fff;
  }

  .s3-mt {
    gap: 10.44px;
    padding: 0 16px;
    font: 500 25.055px/1 'Geist Mono','Commit Mono',monospace;
    letter-spacing: .5px;
    color: #fff;
    font-variant-numeric: tabular-nums;
  }

  .s3-mt:before {
    content: "";
    width: 14.616px;
    height: 14.616px;
    border-radius: 50%;
    background: #4ABE18;
    flex: none;
    animation: s3blink 1.2s steps(2) infinite;
  }

  .s3-mn {
    display: inline-block;
    min-width: 9.2ch;
    text-align: right;
  }

  .s3-mu {
    color: #808080;
  }

  .s3-mc {
    padding-left: 10.44px;
    border-left: 1px solid rgba(255,255,255,.2);
    color: #4ABE18;
  }

  @media (prefers-reduced-motion:reduce) {
    .s3-mt:before {
      animation: none;
    }
  }

  .s3-glass {
    position: absolute;
    -webkit-backdrop-filter: blur(17.721px);
    backdrop-filter: blur(17.721px);
    background: rgba(255,255,255,.06);
    border: 1px solid rgba(255,255,255,.18);
    box-sizing: border-box;
  }

  .s3-bar {
    left: 179px;
    top: 288px;
    width: 1562px;
    height: 96px;
    border-radius: 24px;
  }

  .s3-bar>* {
    position: absolute;
  }

  .s3-ul {
    left: 32px;
    top: 23px;
  }

  .s3-uv {
    left: 32px;
    top: 45px;
    font: 600 24px/32px 'Geist','Inter',sans-serif;
    color: #f2f2f2;
    font-variant-numeric: tabular-nums;
  }

  .s3-rng {
    left: 240px;
    top: 37px;
    width: 560px;
    height: 22px;
    margin: 0;
    -webkit-appearance: none;
    appearance: none;
    background: transparent;
    cursor: pointer;
  }

  .s3-rng::-webkit-slider-runnable-track {
    height: 4px;
    border-radius: 2px;
    background: linear-gradient(90deg,#fff 0 var(--f,65%),rgba(255,255,255,.2) var(--f,65%));
  }

  .s3-rng::-moz-range-track {
    height: 4px;
    border-radius: 2px;
    background: linear-gradient(90deg,#fff 0 var(--f,65%),rgba(255,255,255,.2) var(--f,65%));
  }

  .s3-rng::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 20px;
    height: 20px;
    margin-top: -8px;
    border-radius: 50%;
    background: #fff;
    border: 0;
  }

  .s3-rng::-moz-range-thumb {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: #fff;
    border: 0;
  }

  .s3-rng:focus-visible {
    outline: 2px solid #4ABE18;
    outline-offset: 6px;
    border-radius: 4px;
  }

  .s3-e0 {
    left: 240px;
    top: 61px;
  }

  .s3-e1 {
    left: 784px;
    top: 61px;
  }

  .s3-vs {
    left: 848px;
    top: 23px;
  }

  .s3-chips {
    left: 848px;
    top: 43px;
    display: flex;
    gap: 8px;
  }

  .s3-chips button {
    height: 40px;
    padding: 0 15px;
    border-radius: 20px;
    border: 1px solid rgba(255,255,255,.24);
    background: transparent;
    color: #f2f2f2;
    font: 500 14px/1 'Inter',sans-serif;
    cursor: pointer;
    transition: background .25s,color .25s;
  }

  .s3-chips button[aria-pressed="true"] {
    background: #fff;
    color: #111110;
  }

  .s3-chips button:focus-visible {
    outline: 2px solid #4ABE18;
    outline-offset: 2px;
  }

  .s3-card {
    top: 416px;
    width: 769px;
    height: 472px;
    border-radius: 24px;
  }

  .s3-cl {
    left: 179px;
  }

  .s3-tk {
    left: 972px;
    background: rgba(255,255,255,.12);
  }

  .s3-in {
    position: absolute;
    left: 56px;
    right: 56px;
    top: 56px!important;
    transform: none!important;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .s3-cl .s3-in {
    top: 40px;
  }

  .s3-tk .s3-in {
    top: 50%;
    transform: translateY(-50%);
  }

  .s3-big {
    font-family: 'Geist','Inter',sans-serif;
    font-size: 96px;
