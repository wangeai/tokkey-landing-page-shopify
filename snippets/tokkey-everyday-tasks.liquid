                <div class="gl-window" style="left:45px;top:15px;width:698px;height:314px">
                  {% render 'tokkey-gallery-part', part: 'chrome' %}
                  <div class="gl-content" style="background:#18181c">
                    <i class="gl-box" style="left:0;top:0;width:137px;height:280px;background:#1d1d22"></i>
                    <p class="gl-x" style="left:16px;top:19px;font-size:9px;letter-spacing:1.5px;color:#686871">EXPLORER</p>
                    <p class="gl-x" style="left:17px;top:51px;font-size:11px;color:#92929d">src</p>
                    <i class="gl-box" style="left:7px;top:76px;width:122px;height:27px;border-radius:4px;background:rgb(255 255 255 / 0.04)"></i>
                    <p class="gl-x" style="left:26px;top:82px;font-size:11px;color:#d7d7dd">App.tsx</p>
                    <p class="gl-x" style="left:26px;top:119px;font-size:11px;color:#7d7d87">styles.css</p>
