{% stylesheet %}
  /* "Everyday AI tasks" gallery (Figma 1607:6942). Scenes are drawn at the 788px design width and
     zoomed to the card by --gl-z (set by assets/tokkey-everyday-tasks.js). */
  tokkey-everyday-tasks {
    display: block;
  }

  .gl-sec {
    padding: 94px 8.333vw 84px;
    background: #000;
    font-family: Inter, sans-serif;
    line-height: 1.4;
    color: #a1a1a6;
  }

  .gl-wrap {
    display: flex;
    flex-direction: column;
    gap: 44px;
    max-width: 1600px;
    margin: 0 auto;
  }

  .gl-sec p,
  .gl-sec h2,
  .gl-sec h3 {
    margin: 0;
  }

  /* Header */
  .gl-head {
    display: flex;
    flex-direction: column;
    gap: 15px;
  }

  .gl-eye,
  .gl-cat span {
    font: 400 12px/18px 'JetBrains Mono', monospace;
    letter-spacing: 1.7px;
    color: #a1a1a6;
  }

  .gl-title {
    font-size: clamp(40px, 3.958vw, 76px);
    font-weight: 400;
    line-height: 1.184;
    letter-spacing: -0.0487em;
    color: #86868b;
  }

  .gl-title b {
    font-weight: 600;
    color: #f2f2f2;
  }

  .gl-intro {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 24px;
    font-size: 18px;
  }

  .gl-promise {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font: 400 10px/1.4 'JetBrains Mono', monospace;
    letter-spacing: 0.7px;
    color: #86868b;
  }

  /* Two independent masonry columns */
  .gl-cols {
    display: flex;
    align-items: flex-start;
    gap: 24px;
  }

  .gl-col {
    display: flex;
    flex: 1 1 0;
    flex-direction: column;
    gap: 24px;
    min-width: 0;
  }

  .gl-card {
    container-type: inline-size;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid #27272b;
    border-radius: 24px;
    background: #0b0b0d;
  }

  /* Caption: sizes scale with the card (788px design width) */
  .gl-cap {
    display: flex;
    flex-direction: column;
    gap: 20px;
    min-height: min(142px, 18.02cqw);
    padding: min(33px, 4.19cqw) min(38px, 4.82cqw) min(24px, 3.05cqw);
    box-sizing: border-box;
  }

  .gl-cat {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .gl-cat img {
    width: 18px;
    height: 18px;
  }

  /* Corner arrow that opens the game full screen */
  .gl-expand {
    display: inline-flex;
    margin: -8px;
    padding: 8px;
    border: 0;
    border-radius: 8px;
    background: none;
    cursor: pointer;
    transition: background-color 0.2s;
  }

  .gl-expand:hover {
    background: rgb(255 255 255 / 0.08);
  }

  .gl-expand:focus-visible {
    outline: 2px solid #4abe18;
    outline-offset: 2px;
  }

  .gl-cap h3 {
    font-size: clamp(20px, 4.061cqw, 32px);
    font-weight: 400;
    line-height: 1.3125;
    letter-spacing: -0.028em;
    color: #86868b;
  }

  .gl-cap h3 b {
    font-weight: 400;
    color: #f2f2f2;
  }

  /* Scene: fixed design-size stage zoomed to the card width */
  .gl-scene {
    overflow: hidden;
  }

  /* Playable game in the "CREATE & BUILD" card */
  .gl-game {
    display: block;
    width: 100%;
    aspect-ratio: 788 / 560;
    border: 0;
    border-top: 1px solid #27272b;
    background: #120f1f;
  }

  .gl-game-close {
    display: none;
  }

  /* Full-screen mode: the wrapper covers the viewport (also where the Fullscreen API is unavailable, e.g. iPhone) */
  .gl-game-wrap.is-full {
    position: fixed;
    inset: 0;
    z-index: 2147483647;
    height: 100dvh;
    background: #120f1f;
  }

  .gl-game-wrap.is-full .gl-game {
    height: 100%;
    aspect-ratio: auto;
    border-top: 0;
  }

  .gl-game-wrap.is-full .gl-game-close {
    position: absolute;
    /* Top corner, just below the game's flame bar (drawn at y 40–55) */
    inset-block-start: calc(68px + env(safe-area-inset-top));
    inset-inline-end: 16px;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid rgb(255 255 255 / 0.2);
    border-radius: 50%;
    background: rgb(13 16 22 / 0.7);
    color: #fbe8c8;
    cursor: pointer;
  }

  .gl-game-close:focus-visible {
    outline: 2px solid #4abe18;
    outline-offset: 2px;
  }

  .gl-game-close svg {
    width: 20px;
    height: 20px;
  }

  /* The card's container-type would make it the containing block of the fixed overlay */
  .gl-card:has(.gl-game-wrap.is-full) {
    container-type: normal;
  }

  /* Locks page scroll behind the full-screen game */
  html:has(.gl-game-wrap.is-full) {
    overflow: hidden;
  }

  .gl-stage {
    position: relative;
    width: 788px;
    overflow: hidden;
    background: #0b0b0d;
    zoom: var(--gl-z, 1);
  }

  .gl-abs,
  .gl-light,
  .gl-box,
  .gl-x,
  .gl-bar {
    position: absolute;
  }

  .gl-light {
    max-width: none;
    pointer-events: none;
  }

  .gl-photo {
    position: absolute;
    left: 0;
    top: 0;
    width: 788px;
    object-fit: cover;
  }

  .gl-x {
    margin: 0;
    font-family: Inter, sans-serif;
    font-weight: 400;
    line-height: 1.4;
    white-space: pre;
  }

  .gl-m {
    font-family: 'JetBrains Mono', monospace;
    letter-spacing: 0.7px;
  }

  .gl-rim {
    position: absolute;
    border-radius: 18px;
    background: linear-gradient(rgb(165 189 217 / 0.31), rgb(124 107 168 / 0.31));
  }

  /* App window: chrome bar plus a content area that children are absolutely placed in */
  .gl-window {
    position: absolute;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 0.25);
    border-radius: 16px;
    background: linear-gradient(rgb(43 43 48 / 0.96), rgb(21 21 24 / 0.98));
    box-shadow: 0 20px 32px rgb(0 0 0 / 0.56);
  }

  .gl-chrome {
    display: flex;
    flex: none;
    align-items: center;
    gap: 12px;
    height: 34px;
    padding: 0 13px;
    background: linear-gradient(rgb(51 51 57 / 0.8), rgb(37 37 41 / 0.67));
  }

  .gl-chrome span {
    flex: 1;
    font: 400 10px/1.4 'JetBrains Mono', monospace;
    letter-spacing: 0.7px;
    text-align: center;
    color: #9999a1;
  }

  .gl-chrome i {
    width: 36px;
  }

  .gl-content {
    position: relative;
    flex: 1;
    overflow: hidden;
  }

  .gl-pill {
    padding: 9px 15px;
    border-radius: 99px;
    background: #dadde7;
    font-size: 11px;
    font-weight: 500;
    color: #171820;
  }

  .gl-status {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 7px 13px 7px 12px;
    border: 1px solid rgb(255 255 255 / 0.13);
    border-radius: 99px;
    background: linear-gradient(rgb(54 54 59 / 0.85), rgb(32 32 36 / 0.92));
    font-size: 11px;
    font-weight: 500;
    white-space: nowrap;
    color: #a1a1a6;
  }

  .gl-file {
    position: absolute;
    box-sizing: border-box;
    width: 150px;
    height: 132px;
    border: 1px solid rgb(255 255 255 / 0.19);
    border-radius: 14px;
    background: linear-gradient(#34343a, #242429);
    filter: drop-shadow(0 20px 16px rgb(0 0 0 / 0.56));
  }

  .gl-file img {
    position: absolute;
    left: 16px;
    top: 16px;
  }

  .gl-file b,
  .gl-file span {
    position: absolute;
    left: 16px;
    white-space: nowrap;
  }

  .gl-file b {
    top: 72px;
    font-size: 13px;
    font-weight: 500;
    color: #f2f2f2;
  }

  .gl-file span {
    top: 98px;
    font-size: 10px;
    color: #86868b;
  }

  .gl-folder {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 12px;
    box-sizing: border-box;
    width: 275px;
    height: 49px;
    padding: 0 15px;
    border: 1px solid rgb(255 255 255 / 0.09);
    border-radius: 11px;
    background: linear-gradient(#2c2c32, #202025);
  }

  .gl-folder span {
    flex: 1;
    font-size: 13px;
    color: #a1a1a6;
  }

  .gl-folder em {
    font: 400 10px/1.4 'JetBrains Mono', monospace;
    letter-spacing: 0.7px;
    color: #86868b;
  }

  .gl-rewrite {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px 14px 12px 16px;
    border: 1px solid rgb(255 255 255 / 0.16);
    border-radius: 11px;
    background: linear-gradient(rgb(65 65 71 / 0.95), rgb(41 41 47 / 0.95));
    box-shadow: 0 20px 32px rgb(0 0 0 / 0.56);
    font-size: 12px;
    white-space: nowrap;
    color: #d1d1dc;
  }

  .gl-rewrite span + i + span {
    color: #a2a2b0;
  }

  .gl-rewrite i {
    width: 1px;
    height: 15px;
    background: rgb(255 255 255 / 0.11);
  }

  .gl-rewrite img {
    width: 14px;
    height: 14px;
  }

  /* Frosted panels over the photos */
  .gl-glass {
    position: absolute;
    box-sizing: border-box;
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 0.21);
    border-radius: 17px;
    background: linear-gradient(rgb(50 50 54 / 0.85), rgb(29 29 33 / 0.9));
    box-shadow: 0 20px 32px rgb(0 0 0 / 0.56);
  }

  .gl-bar {
    width: 2px;
    border-radius: 1px;
    background: #c7c7db;
  }

  .gl-bar-rest {
    background: #4c4c58;
  }

  /* Soft merge of each scene into the card's graphite */
  .gl-fade {
    position: absolute;
    left: 0;
    width: 788px;
    background: linear-gradient(rgb(11 11 13 / 0), #0b0b0d);
    pointer-events: none;
  }

  .gl-fade-top {
    background: linear-gradient(#0b0b0d, rgb(11 11 13 / 0));
  }

  /* Closing line */
  .gl-end {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 24px;
    padding-top: 8px;
  }

  .gl-sent {
    font-size: clamp(22px, 1.5625vw, 30px);
    letter-spacing: -0.027em;
    color: #86868b;
  }

  .gl-sent b {
    font-weight: 600;
    color: #f2f2f2;
  }

  .gl-link {
    display: inline-flex;
    align-items: center;
    gap: 15px;
    font-size: 15px;
    color: #a1a1a6;
    text-decoration: none;
  }

  .gl-link:hover {
    color: #f2f2f2;
  }

  .gl-link:focus-visible {
    outline: 2px solid #4abe18;
    outline-offset: 4px;
    border-radius: 4px;
  }

  .gl-link img {
    width: 17px;
    height: 17px;
  }

  /* Below 1024px: one column, cards in their numbered order */
  @media (max-width: 1023px) {
    .gl-sec {
      padding: 64px 24px;
    }

    .gl-wrap {
      gap: 32px;
    }

    .gl-cols {
      flex-direction: column;
      align-items: stretch;
      gap: 16px;
    }

    .gl-col {
      display: contents;
    }

    .gl-card {
      order: var(--gl-order);
      border-radius: 20px;
    }

    .gl-intro {
      font-size: 16px;
    }
  }

  /* Phones: taller frame so the game's title screen and HUD fit */
  @media (max-width: 767px) {
    .gl-game {
      aspect-ratio: 4 / 5;
    }
  }
{% endstylesheet %}
