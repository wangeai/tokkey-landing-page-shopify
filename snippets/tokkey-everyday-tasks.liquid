{% doc %}
  Renders the "Everyday AI tasks. Done on your Mac." gallery from Figma
  (Homepage 06 · Do more. Keep it yours. / V2 Graphite, node 1607:6942): a header, two independent
  masonry columns of eight task cards (the first plays the "Lantern Rise" game in an iframe), and a closing line. Each card is a caption plus a 788px-wide
  scene drawn at design size; assets/tokkey-everyday-tasks.js zooms the scenes to the card width.
  Below 1024px the cards stack in their numbered order.

  @example
  {% render 'tokkey-everyday-tasks' %}
{% enddoc %}

{%- liquid
  # Meeting waveform bar heights (Figma "Audio waveform 0–71"); the first 48 bars are played
  assign wave_heights = '20,31,30,20,16,25,34,31,18,10,15,24,23,11,4,11,24,27,19,12,19,32,35,26,16,18,27,30,19,7,8,18,24,17,8,10,23,32,28,18,17,28,35,29,15,10,18,25,21,9,4,14,25,25,16,12,22,34,34,23,15,20,29,28,16,6,10,21,23,15,7,12' | split: ','
-%}

<tokkey-everyday-tasks>
  <section class="gl-sec" id="glsec" aria-labelledby="gl-title">
    <div class="gl-wrap">
      <header class="gl-head">
        <p class="gl-eye">EVERYDAY POSSIBILITIES</p>
        <h2 class="gl-title" id="gl-title"><b>Everyday AI tasks.</b> <span>Done on your Mac.</span></h2>
        <div class="gl-intro">
          <p>Write, code, summarize and organize. All on your Mac, nothing uploaded.</p>
          <span class="gl-promise"><img src="{{ 'tk-gl-dot.svg' | asset_url }}" width="5" height="5" alt="" loading="lazy">LOCAL BY DEFAULT</span>
        </div>
      </header>

      <div class="gl-cols">
        {%- comment -%} Left column: build, code, write, remember {%- endcomment -%}
        <div class="gl-col">
          <article class="gl-card" style="--gl-order: 1">
            {% render 'tokkey-gallery-part', part: 'caption', label: 'CREATE & BUILD', detail: 'Describe an app.', rest: 'Get a working one.', action: 'Play Lantern Rise full screen' %}
            {%- comment -%}
              Playable "Lantern Rise" game (assets/tokkey-lantern-rise.js). An iframe keeps the game's
              window-sized canvas, key handling and storage isolated from the page.
            {%- endcomment -%}
            {%- capture game_doc -%}
              <!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
              <style>html,body{margin:0;height:100%;overflow:hidden;background:#120f1f}canvas{display:block;width:100%;height:100%;touch-action:none}</style></head>
              <body><canvas id="c"></canvas>
              <script>addEventListener('keydown',function(e){if(['ArrowLeft','ArrowRight','ArrowUp','ArrowDown','Space'].indexOf(e.code)>-1)e.preventDefault();if(e.key==='Escape')parent.document.dispatchEvent(new KeyboardEvent('keydown',{key:'Escape'}))});</script>
              <script src="{{ 'tokkey-lantern-rise.js' | asset_url }}" defer></script></body></html>
            {%- endcapture -%}
            <div class="gl-game-wrap">
              <iframe class="gl-game" title="Lantern Rise, a playable mini-game" srcdoc="{{ game_doc | escape }}" loading="lazy"></iframe>
              <button class="gl-game-close" type="button" aria-label="Exit full screen" data-gl-close>
                {{- 'icon-close.svg' | inline_asset_content -}}
              </button>
            </div>
          </article>

          <article class="gl-card" style="--gl-order: 3">
            {% render 'tokkey-gallery-part', part: 'caption', label: 'CODE & DEBUG', detail: 'Fix your code.', rest: 'With AI on your Mac.' %}
            <div class="gl-scene">
