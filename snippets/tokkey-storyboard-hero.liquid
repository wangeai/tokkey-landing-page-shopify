{% doc %}
  Renders the storyboard hero ported from the prototype homepage v3: a 1920×1080 stage where the
  MacBook lid opens (frame sequence drawn on a canvas), the camera pushes in on the key, the MacBook
  dissolves into the Mac mini and the headline lands on "Own your intelligence". Below 1024px the stage
  is fitted to the viewport width (16:9) with 1080px frames, and the sub-lines render under it.
  Animation is driven by assets/tokkey-storyboard-hero.js.

  @example
  {% render 'tokkey-storyboard-hero' %}
{% enddoc %}

{%- liquid
  # The prototype's 36 frames are 9 distinct images; the script maps frame index onto these.
  # Each frame also has a 1080px-wide "-m" variant that the script loads on small screens.
  assign frame_names = 'f00,f05,f10,f15,f20,f25,f30,f34,hi' | split: ','
  assign frames_json = ''
  assign frames_json_mobile = ''
  for name in frame_names
    assign frame_url = 'tk-hv-' | append: name | append: '.webp' | asset_url | json
    assign frame_url_mobile = 'tk-hv-' | append: name | append: '-m.webp' | asset_url | json
    unless forloop.first
      assign frames_json = frames_json | append: ','
      assign frames_json_mobile = frames_json_mobile | append: ','
    endunless
    assign frames_json = frames_json | append: frame_url
    assign frames_json_mobile = frames_json_mobile | append: frame_url_mobile
  endfor
  assign frames_json = '[' | append: frames_json | append: ']'
  assign frames_json_mobile = '[' | append: frames_json_mobile | append: ']'
-%}

