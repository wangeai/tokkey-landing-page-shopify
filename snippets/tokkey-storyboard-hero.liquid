{% stylesheet %}
  /* Storyboard hero (prototype homepage v3). The stage is a fixed 1920×1080 canvas scaled by --hvz. */
  .hv {
    background: #000;
    line-height: normal;
  }

  .hv-view {
    position: relative;
    display: block;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
    background: #000;
  }

  .hv-preload {
    position: absolute;
    left: -9999px;
    top: 0;
    font-size: 20px;
  }

  .hv-stage {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 1920px;
    height: 1080px;
    transform: translate(-50%, -50%) scale(var(--hvz, 1));
    overflow: hidden;
    background: #000;
    font-family: 'HV Inter', Inter, system-ui, sans-serif;
    color: #fff;
  }

  .hv-layer {
    position: absolute;
    left: 0;
    top: 0;
    will-change: transform, opacity, filter;
  }

  .hv-mbw {
    width: 1920px;
    height: 1080px;
    transform-origin: 639px 714px;
  }

  .hv-mb {
    display: block;
    width: 1920px;
    height: 1080px;
  }

  .hv-cut {
    left: 733px;
    top: 70px;
    width: 1465px;
    max-width: none;
    height: auto;
    opacity: 0;
    transform-origin: 15.5% 63.4%;
  }

  .hv-shade {
    position: absolute;
    left: 0;
    top: 0;
    width: 1920px;
    height: 640px;
    background: linear-gradient(#000 0, rgb(0 0 0 / 0.85) 30%, rgb(0 0 0 / 0) 100%);
    pointer-events: none;
  }

  .hv-shade-b {
    top: auto;
    bottom: 0;
    height: 420px;
    background: linear-gradient(rgb(0 0 0 / 0), rgb(0 0 0 / 0.7) 60%, rgb(0 0 0 / 0.85));
    opacity: 0;
  }

  .hv-h1 {
    position: absolute;
    left: 0;
    top: 210px;
    width: 1920px;
    margin: 0;
    text-align: center;
    font-family: Geist, 'HV Inter', sans-serif;
    font-weight: 300;
    font-size: 112px;
    line-height: 156px;
    letter-spacing: -0.03em;
    color: #808080;
  }

  .hv-ph {
    display: inline-grid;
    justify-items: center;
    white-space: nowrap;
  }

  .hv-ph > b {
    grid-area: 1 / 1;
    display: inline-flex;
    align-items: center;
    gap: 0 0.23em;
    font-weight: 300;
    opacity: 0;
    transform: translateY(0.14em);
    filter: blur(8px);
    transition: opacity 0.45s ease, transform 0.55s cubic-bezier(0.2, 0.8, 0.2, 1), filter 0.45s ease;
  }

  .hv-ph > b.on {
    opacity: 1;
    transform: none;
    filter: none;
  }

  .hv-ph em,
  .hv-l2 em {
    font-style: normal;
    font-weight: 600;
    color: #fff;
  }

  .hv-ph .hv-intl {
    color: #fff;
  }

  /* Inline pill and key chip */
  .hv-pill {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    height: 71px;
    border: 1.8px solid rgb(255 255 255 / 0.2);
    border-radius: 200px;
    background: rgb(255 255 255 / 0.06);
    letter-spacing: 0;
  }

  .hv-pk {
    width: 120px;
    gap: 7.5px;
    padding: 0 15px;
  }

  .hv-pk i {
    position: relative;
    width: 63.5px;
    height: 52.3px;
    border-radius: 9.3px;
    background: #e9e9ec;
  }

  .hv-pk i::after {
    content: "";
    position: absolute;
    left: 13px;
    top: 16.8px;
    width: 5.6px;
    height: 18.7px;
    border-radius: 1.9px;
    background: #111;
  }

  .hv-pk u {
    width: 26px;
    height: 18.7px;
    border-radius: 5.6px;
    background: #55555a;
  }

  .hv-pl {
    gap: 18.7px;
    padding: 0 28px;
    font: 500 44px/1 'Geist Mono', monospace;
    letter-spacing: 0.02em;
    color: #fff;
  }

  .hv-pl::before {
    content: "";
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: #4abe18;
  }

  .hv-ph > b .hv-pl {
    opacity: 0;
    transform: scale(0.7);
    transition: opacity 0.4s ease 0.35s, transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1.2) 0.35s;
  }

  .hv-ph > b.on .hv-pl {
    opacity: 1;
    transform: none;
  }

  .hv-intl {
    display: inline-block;
    font-family: 'HV Ancizar', serif;
    font-style: italic;
    font-weight: 400;
  }

  .hv-l2 {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0 0.23em;
    color: #808080;
  }

  .hv-l2 .hv-dot {
    margin-inline-start: -0.2em;
  }

  .hv-lt {
    font-weight: 300;
    color: #808080;
  }

  .hv-gr {
    color: #4abe18;
  }

  .hv-sub {
    position: absolute;
    left: 0;
    width: 1920px;
    margin: 0;
    text-align: center;
    font-size: 40px;
    line-height: 56px;
    letter-spacing: -0.03em;
    opacity: 0;
  }

  .hv-sub-1 {
    top: 900px;
    font-weight: 700;
    color: #fff;
  }

  .hv-sub-2 {
    top: 956px;
    font-weight: 300;
    color: rgb(255 255 255 / 0.4);
  }

  .hv-mob {
    display: none;
  }

  .hv-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    margin: 0;
  }

  /* Partner row under the hero */
  .hv-pband {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 28px;
    padding: 56px 24px 40px;
    background: #000;
  }

  .hv-pband > .ptn-k {
    font: 400 12px/1 'Geist Mono', ui-monospace, monospace;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.4);
  }

  .hv-partners {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 24px 52px;
    max-width: 100%;
    color: rgb(255 255 255 / 0.62);
    zoom: 1.25;
  }

  .hv-partners .ptn-i {
    display: flex;
    align-items: center;
  }

  .hv-partners .ptn-l {
    display: block;
    flex: none;
  }

  .hv-partners .ptn-t {
    font: 800 21px/1 Inter, system-ui, sans-serif;
    letter-spacing: 0.02em;
  }

  @media (max-width: 1023px) {
    /* The stage plays here too, contain-fitted to a 16:9 box; the tiny in-stage sub-lines move below it */
    .hv-view {
      height: auto;
      aspect-ratio: 16 / 9;
      overflow: hidden;
    }

    .hv-sub {
      display: none;
    }

    .hv-mob {
      display: block;
      padding: 8px 20px 8px;
      text-align: center;
      font-family: 'HV Inter', Inter, sans-serif;
      color: #fff;
    }

    .hv-mob-a {
      margin: 8px 0 0;
      font-weight: 700;
      font-size: 20px;
      line-height: 1.3;
      letter-spacing: -0.02em;
    }

    .hv-mob-b {
      margin: 4px 0 0;
      font-weight: 300;
      font-size: 16px;
      line-height: 1.4;
      color: rgb(255 255 255 / 0.55);
    }

    .hv-pband {
      gap: 20px;
      padding: 40px 16px 24px;
    }

    .hv-partners {
      zoom: 1;
    }
  }
{% endstylesheet %}
