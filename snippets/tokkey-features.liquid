  @media (max-width:1023px) {
    .ft-sec {
      height: auto;
    }

    .ft-c {
      position: static;
      width: auto;
      height: auto;
      transform: none;
      padding: var(--sp) 24px;
      display: flex;
      flex-direction: column;
    }

    .ft-h {
      position: static;
      width: auto;
      white-space: normal;
      font-size: clamp(32px,7vw,48px)!important;
      line-height: 1.22!important;
      letter-spacing: -.03em!important;
      gap: 0 .22em;
    }

    .ft-c>*:not(.ft-h):not(.ft-rail) {
      display: none;
    }

    .ft-h span,
    .ft-h b {
      display: block;
    }

    .ft-rail {
      position: static;
      width: auto;
      margin-top: 40px;
      gap: 0;
    }

    .ft-sw {
      width: auto;
      height: auto!important;
      padding: 20px 0 20px 40px;
      border: 0;
      border-top: 1px solid #2e2e2b;
      border-radius: 0;
      background: transparent!important;
      pointer-events: none;
    }

    .ft-sw em {
      top: 23px!important;
      left: 0;
      color: #4ABE18!important;
    }

    .ft-sw b {
      position: static;
      display: block;
      font: 600 20px/28px 'Geist','Inter',sans-serif!important;
      color: #f2f2f2!important;
    }

    .ft-sw span {
      position: static;
      display: block;
      width: auto;
      opacity: 1!important;
      margin-top: 6px;
      font-size: 15px;
      line-height: 22px;
    }

    .ft-sw u {
      display: none;
    }
  }

  @media (min-width:1024px) {
    .ft-h {
      white-space: nowrap;
      display: block!important;
    }

    .ft-h span {
      display: inline!important;
    }

    .ft-h b {
      display: inline!important;
      margin-left: .22em;
    }

    .ft-c>*:not(.ft-h):not(.ft-rail) {
      translate: 0 140px;
    }

    .ft-rail {
      top: 268px!important;
    }
  }

  .ft-sec {
    background: transparent!important;
  }

  @keyframes ftprog {
    from {
      transform: scaleY(0);
    }
    to {
      transform: scaleY(1);
    }
  }

  @keyframes rtpk {
    0% {
      opacity: 0;
      left: 297.6px;
      top: 81.4px;
    }
    8% {
      opacity: 1;
    }
    22% {
      opacity: 1;
      left: 297.6px;
      top: 104.6px;
    }
    24%,38% {
      opacity: 0;
      left: 297.6px;
      top: 125px;
    }
    40% {
      opacity: 1;
      left: 297.6px;
      top: 146.5px;
    }
    52% {
      left: 297.6px;
      top: 171.6px;
    }
    80% {
      left: 151.1px;
      top: 171.6px;
    }
    94% {
      opacity: 1;
      left: 151.1px;
      top: 203.4px;
    }
    100% {
      opacity: 0;
      left: 151.1px;
      top: 203.4px;
    }
  }

  @keyframes rtpulse {
    40% {
      border-color: #4ABE18;
      box-shadow: 0 0 0 3px rgba(74,190,24,.18);
    }
  }

  @keyframes pcblink {
    50% {
      opacity: 0;
    }
  }

  @keyframes pcsend {
    0% {
      box-shadow: 0 0 0 0 rgba(74,190,24,.55);
    }
    100% {
      box-shadow: 0 0 0 14px rgba(74,190,24,0);
    }
  }

  @keyframes ahdot {
    0%,60%,100% {
      opacity: .3;
      transform: none;
    }
    30% {
      opacity: 1;
      transform: translateY(-2px);
    }
  }
{% endstylesheet %}
