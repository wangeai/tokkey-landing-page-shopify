  @media (prefers-reduced-motion:reduce) {
    .ft-a,
    .ft-cap,
    .ft-sc,
    .ft-sw,
    .sc-exp .f-pg i {
      transition: none!important;
    }

    .ft-sec.auto .ft-sw[aria-selected="true"] u {
      animation: none;
    }
  }

  .rt-pk {
    position: absolute;
    left: 297.6px;
    top: 81.4px;
    width: 6px;
    height: 6px;
    margin: -3px 0 0 -3px;
    border-radius: 50%;
    background: #4ABE18;
    box-shadow: 0 0 8px 2px rgba(74,190,24,.55);
    opacity: 0;
    pointer-events: none;
  }

  .rt-pk.go {
    animation: rtpk 1.5s cubic-bezier(.45,0,.25,1) forwards;
  }

  .ft-sc.f-on .rt-loc.rt-dim {
    opacity: .4;
  }

  .rt-loc {
    transition: opacity .5s ease,transform .7s cubic-bezier(.2,.8,.2,1);
  }

  .rt-dec.pulse {
    animation: rtpulse .9s ease;
  }

  .pc-tx {
    display: inline-block;
    font: 400 13px/18px -apple-system,'SF Pro Text',system-ui,'Inter',sans-serif;
    color: #f2f2f2;
    white-space: nowrap;
    transition: opacity .3s;
  }

  .pc-tx:empty {
    opacity: 0;
  }

  .pc-tx.sent {
    opacity: 0;
  }

  .pc-tx:after {
    content: "";
    display: inline-block;
    width: 1.5px;
    height: 16px;
    margin-left: 2px;
    background: #f2f2f2;
    vertical-align: -3px;
    animation: pcblink 1s steps(1) infinite;
  }

  .pc-send.go {
    animation: pcsend .8s ease-out;
  }

  .ah-typ {
    position: absolute;
    left: 170px;
    top: 184px;
    width: 44px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    border-radius: 14px;
    background: rgba(74,190,24,.16);
    opacity: 0;
    transition: opacity .25s;
  }

  .ah-typ i {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #f2f2f2;
    animation: ahdot 1s ease-in-out infinite;
  }

  .ah-typ i:nth-child(2) {
    animation-delay: .15s;
  }

  .ah-typ i:nth-child(3) {
    animation-delay: .3s;
  }

  .ah-typ.in {
    opacity: 1;
  }

  .ah-me {
    transition: opacity .35s,transform .45s cubic-bezier(.2,.8,.2,1);
  }

  .ah-me.hide {
    opacity: 0;
    transform: translateY(6px);
  }

  .ah-r button {
    transition: transform .15s,background .3s,color .3s;
  }

  .ah-r button.press {
    transform: scale(.9);
  }

  .ah-row.live .ah-l span:before {
    content: "";
    display: inline-block;
    width: 5px;
    height: 5px;
    margin-right: 4px;
    border-radius: 50%;
    background: #4ABE18;
    vertical-align: 1px;
  }

  .wf-ar>div span {
    transition: color .3s;
  }

  .wf-ar>div span.ok {
    color: #4ABE18;
  }

  .wf-tr .f-cb {
    transition: background .3s,border-color .3s;
  }

  .wf-tr>b {
    transition: color .3s;
  }

  .sc-ring {
    flex: none;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: conic-gradient(#4ABE18 calc(var(--p,62) * 1%),#2E2E2B 0);
    -webkit-mask: radial-gradient(farthest-side,transparent calc(100% - 2px),#000 calc(100% - 2px));
    mask: radial-gradient(farthest-side,transparent calc(100% - 2px),#000 calc(100% - 2px));
  }

  .sc-isl:after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(90deg,rgba(74,190,24,.3),rgba(74,190,24,.1));
    transform: scaleX(0);
    transform-origin: left;
    transition: transform .9s cubic-bezier(.65,0,.35,1);
    pointer-events: none;
  }

  .sc-isl.done:after {
    transform: none;
  }

  .sc-isl>* {
    position: relative;
    z-index: 1;
  }

  .sc-exp .f-st {
    transition: color .3s;
  }

  .sc-exp .f-d {
    transition: background .3s,border-color .3s;
  }

  .pcw {
    position: absolute;
    width: 688px;
    height: 327px;
    font-family: -apple-system,'SF Pro Text',system-ui,'Inter',sans-serif;
    color: #fff;
  }

  .pcw>* {
    position: absolute;
  }

  .pc-glass {
    border-radius: 13px;
    background: rgba(84,84,84,.67);
    border: 1px solid rgba(255,255,255,.22);
    -webkit-backdrop-filter: blur(20px);
