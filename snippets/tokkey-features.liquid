<script src="{{ 'tokkey-features.js' | asset_url }}" defer></script>

{% stylesheet %}
  /* Ported from the prototype homepage v3; a 1920px design canvas scaled by --z below 1920px */
  tokkey-features {
    display: block;
    line-height: normal;
  }

  .ft-sec {
    --z: 1;
    position: relative;
    height: calc(1078px * var(--z));
    background: #000;
    overflow: hidden;
    color: #f2f2f2;
  }

  .ft-c {
    position: absolute;
    left: 50%;
    top: calc(28px * var(--z));
    width: 1920px;
    height: 1000px;
    transform: translateX(-50%) scale(var(--z));
    transform-origin: top center;
    font-family: 'Inter',sans-serif;
  }

  .ft-c * {
    box-sizing: border-box;
  }

  .ft-c p {
    margin: 0;
  }

  .ft-eye {
    position: absolute;
    left: 179px;
    top: 64px;
    font: 500 12px/24px 'Inter',sans-serif;
    letter-spacing: 1.44px;
    color: #62625e;
  }

  .ft-h {
    position: absolute;
    left: 179px;
    top: 112px;
    margin: 0;
    font: 300 62.638px/76.21px 'Geist','Inter',sans-serif;
    letter-spacing: -1.8792px;
    color: #808080;
  }

  .ft-h span,
  .ft-h b {
    display: block;
    white-space: nowrap;
  }

  .ft-h b {
    font-weight: 600;
    color: #fff;
  }

  .ft-h i {
    font-style: normal;
    color: #4ABE18;
  }

  .ft-rail {
    position: absolute;
    left: 179px;
    top: 344px;
    width: 352px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .ft-sw {
    position: relative;
    display: block;
    width: 352px;
    height: 64px;
    padding: 0;
    margin: 0;
    border: 1px solid transparent;
    border-radius: 16px;
    background: transparent;
    text-align: left;
    cursor: pointer;
    font-family: 'Inter',sans-serif;
    color: inherit;
    transition: height .35s cubic-bezier(.2,.8,.2,1),background .3s,border-color .3s;
  }

  .ft-sw em {
    position: absolute;
    left: 23px;
    top: 21px;
    font: 400 12px/20px 'Inter',sans-serif;
    font-style: normal;
    letter-spacing: .24px;
    color: #62625e;
    transition: color .3s,top .35s;
  }

  .ft-sw b {
    position: absolute;
    left: 63px;
    top: 19px;
    font: 400 18px/24px 'Inter',sans-serif;
    color: #a3a3a0;
    white-space: nowrap;
    transition: color .3s,top .35s;
  }

  .ft-sw span {
    position: absolute;
    left: 63px;
    top: 48px;
    width: 264px;
    font: 400 13px/20px 'Inter',sans-serif;
    color: #a3a3a0;
    opacity: 0;
    transition: opacity .3s;
  }

  .ft-sw u {
    position: absolute;
    left: -1px;
    top: 23px;
    width: 2px;
    height: 40px;
    border-radius: 1px;
    background: #4ABE18;
    transform: scaleY(0);
    transform-origin: top;
  }

  .ft-sw:hover b {
    color: #f2f2f2;
  }

  .ft-sw:focus-visible {
    outline: 2px solid #4ABE18;
    outline-offset: 2px;
  }

  .ft-sw[aria-selected="true"] {
    height: 88px;
    background: #111110;
    border-color: #343432;
  }

  .ft-sw[aria-selected="true"] em {
    top: 20px;
    color: #a3a3a0;
  }

  .ft-sw[aria-selected="true"] b {
    top: 17px;
    font-weight: 600;
    color: #f2f2f2;
  }

  .ft-sw[aria-selected="true"] span {
    opacity: 1;
    transition-delay: .12s;
  }

  .ft-sw[aria-selected="true"] u {
    transform: scaleY(1);
  }

  .ft-sec.auto .ft-sw[aria-selected="true"] u {
    animation: ftprog var(--dur,6.5s) linear forwards;
  }

  .ft-screen {
    position: absolute;
    left: 624px;
    top: 128px;
    width: 1120px;
    height: 641.951px;
    background: #111110;
    border-radius: 27.317px;
    overflow: hidden;
    outline: 1.28px solid #dadad6;
    outline-offset: -1.28px;
  }

  .ft-rim {
    position: absolute;
    left: 1.28px;
    top: 1.28px;
    width: 1114.878px;
    height: 636.829px;
    border: 1.707px solid #000;
    border-radius: 24.756px;
    background: linear-gradient(#1e1e1d,#0b0b0b);
  }

  .ft-glass {
    position: absolute;
    left: 10.67px;
    top: 10.67px;
    width: 1096.098px;
    height: 618.049px;
    background: #000;
    border: .854px solid #343432;
    border-radius: 15.366px;
  }

  .ft-canvas {
    position: absolute;
    left: 12.38px;
    top: 12.38px;
    width: 1092.683px;
    height: 614.634px;
    background: #0b0b0b;
    border-radius: 13.659px;
    overflow: hidden;
  }

  .ft-fall {
    position: absolute;
    inset: 0;
    background: linear-gradient(#151515,#090909);
    opacity: .65;
  }

  .ft-wm {
    position: absolute;
    left: 450.73px;
    top: 300.49px;
    width: 191.22px;
    height: 48.682px;
  }

  .ft-chrome {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 58.049px;
    background: #000;
  }

  .ft-chrome img {
    position: absolute;
    left: 27.32px;
    top: 21.34px;
    width: 61.463px;
    height: 15.648px;
  }

  .ft-chrome span {
    position: absolute;
    right: 74px;
    top: 21.34px;
    font: 500 11.951px/17.073px 'Inter',sans-serif;
    color: #a3a3a0;
    white-space: nowrap;
  }

  .ft-chrome i {
    position: absolute;
    left: 0;
    top: 57.2px;
    width: 100%;
    height: .854px;
    background: #343432;
  }

  .ft-notch {
    position: absolute;
    left: 504.09px;
    top: 12.38px;
    width: 109.268px;
    height: 17.073px;
    background: #000;
    border-radius: 0 0 10.244px 10.244px;
