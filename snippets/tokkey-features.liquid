{% doc %}
  Renders the "Features" section ported from the prototype homepage v3 (.ft-sec): a tab rail of
  five features beside a MacBook screen mock, where each tab plays a short UI animation. Tabs
  auto-advance every 5s while visible. Below 1024px only the headline and feature list show.
  Behaviour lives in assets/tokkey-features.js.

  @example
  {% render 'tokkey-features' %}
{% enddoc %}

<tokkey-features>
<section class="ft-sec" id="ftsec" aria-label="Features">
<div class="ft-c">
  
  <h2 class="ft-h"><span>Chat, code, automate.</span><b>AI on your Mac<i>.</i></b></h2>
  <div class="ft-rail" id="ftRail" role="tablist" aria-label="Features">
    <button class="ft-sw" role="tab" data-i="0"><em>01</em><b>Router</b><span>Uses your Mac first. Cloud only if you allow it.</span><u></u></button>
    <button class="ft-sw" role="tab" data-i="1"><em>02</em><b>Private Chat</b><span>Chat with AI. Nothing leaves your Mac.</span><u></u></button>
    <button class="ft-sw" role="tab" data-i="2"><em>03</em><b>Agent Hub</b><span>Download, start and stop models. No terminal.</span><u></u></button>
    <button class="ft-sw" role="tab" data-i="3"><em>04</em><b>Your Workflow</b><span>Works inside the AI tools you already use.</span><u></u></button>
    <button class="ft-sw" role="tab" data-i="4"><em>05</em><b>Same Computer</b><span>No new hardware. Just your Mac.</span><u></u></button>
  </div>

  <div class="ft-screen" aria-hidden="true">
    <div class="ft-rim"></div><div class="ft-glass"></div>
    <div class="ft-canvas"><div class="ft-fall"></div><img width="191" height="49" loading="lazy" class="ft-wm" src="{{ 'tk-ft-watermark.svg' | asset_url }}" alt="">
      <div class="ft-chrome"><img width="61" height="16" loading="lazy" src="{{ 'tk-ft-wordmark.svg' | asset_url }}" alt=""><span id="ftTabName">Router</span><i></i></div></div>
    <div class="ft-notch"></div><img width="3" height="3" loading="lazy" class="ft-cam" src="{{ 'tk-ft-camera.svg' | asset_url }}" alt="">
  </div>

  <div class="ft-stage" role="tabpanel" aria-live="polite">
    <!-- 01 Router -->
    <div class="ft-sc" data-i="0">
      <div class="ft-gl1"><img width="1262" height="978" loading="lazy" src="{{ 'tk-ft-glow-a.svg' | asset_url }}" alt=""></div><div class="ft-gl2"><img width="1379" height="750" loading="lazy" src="{{ 'tk-ft-glow-b1.svg' | asset_url }}" alt=""></div><div class="ft-grid"></div>
      <div class="rt" style="left:232px;top:20px">
