            <div class="pc-r"><span class="pc-cd"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.5" stroke-dasharray="1.6 3"/></svg></span><span class="pc-mdl"><i></i>Qwen 3.5 9B · Local</span><span class="pc-go"><img width="16" height="16" loading="lazy" src="{{ 'tk-ft-pc-send.svg' | asset_url }}" alt=""><i class="pc-send"></i></span></div></div></div>
        <div class="pc-menu pc-glass"><div class="pc-it pc-hi"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5l-8.6 8.6a5.5 5.5 0 0 1-7.8-7.8l9.2-9.2a3.7 3.7 0 0 1 5.2 5.2l-9.2 9.2a1.8 1.8 0 0 1-2.6-2.6l8.5-8.5"/></svg><span>Add files</span></div><div class="pc-it"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6.5A1.5 1.5 0 0 1 4.5 5H9l2 2h8.5A1.5 1.5 0 0 1 21 8.5v9A1.5 1.5 0 0 1 19.5 19h-15A1.5 1.5 0 0 1 3 17.5z"/></svg><span>Work in a folder</span></div><div class="pc-div"><img width="171" height="1" loading="lazy" src="{{ 'tk-ft-pc-divider.svg' | asset_url }}" alt=""></div>
          <div class="pc-it pc-sw"><span><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/></svg>Web Search</span><b><img width="23" height="15" loading="lazy" src="{{ 'tk-ft-pc-track.svg' | asset_url }}" alt=""></b></div><div class="pc-it pc-sw"><span><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="4.5" r="2"/><circle cx="4.5" cy="18.5" r="2"/><circle cx="19.5" cy="18.5" r="2"/><path d="M11 6.5 5.5 16.5M13 6.5l5.5 10M6.5 18.5h11" stroke-dasharray="2 2.2"/></svg>Thinking</span><b><img width="23" height="15" loading="lazy" src="{{ 'tk-ft-pc-track.svg' | asset_url }}" alt=""></b></div></div>
        <div class="pc-tok pc-glass"><div class="pc-th"><b>Token Usage</b><span>12 / 1,048,576</span></div>
          <div class="pc-tr"><span>Input tokens</span><b data-v="100">100</b></div><div class="pc-tr"><span>Output tokens</span><b data-v="10">10</b></div><div class="pc-tr"><span>Total tokens</span><b data-v="110">110</b></div></div>
      </div>
      <div class="ft-cap" style="top:431px"><span class="f-ic ic-pc"><i></i><img width="7" height="7" loading="lazy" src="{{ 'tk-ft-chat-tail.svg' | asset_url }}" alt=""></span><b>Private Chat</b><p>Runs 100% locally — nothing you type ever leaves your Mac.</p></div>
    </div>
    <!-- 03 Agent Hub -->
    <div class="ft-sc" data-i="2">
      <div class="ft-gl1"><img width="1262" height="978" loading="lazy" src="{{ 'tk-ft-glow-a.svg' | asset_url }}" alt=""></div><div class="ft-gl2"><img width="1379" height="750" loading="lazy" src="{{ 'tk-ft-glow-b2.svg' | asset_url }}" alt=""></div><div class="ft-grid"></div>
      <div class="ah-ph ft-a"><span class="f-t">9:41</span><b>Assistant</b><span class="f-on"><img width="5" height="5" loading="lazy" src="{{ 'tk-ft-ah-dot.svg' | asset_url }}" alt="">Active now</span>
        <div class="ah-bot">I've automated the deploy checklist. 12 steps done, 0 sent to the cloud.</div><div class="ah-typ"><i></i><i></i><i></i></div><div class="ah-me">Nice — ship it.</div></div>
      <div class="ah-pn ft-a">
        <div class="ah-hd"><div><b>Local Models</b><span>Download, start, and manage models stored on this Mac.</span></div><em>+&nbsp;&nbsp;Add model</em></div>
        <div class="ah-sub"><b>Installed</b><span>2 model</span></div>
